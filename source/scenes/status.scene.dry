@relations

= <span class="tooltip-text" title="Foreign Relations are the relations between countries in a broad sense. They adapt to government policies and to a lesser extent to inter-party relations.
" >Foreign Relations</span>

<span style="color: #002654;">**Western**</span> <span style="color: #D7141A;">**Allies**</span>: [+ west_relation : relationships +]

<span style="color: #002654;">**U**</span><span style="color: #D3D3D3;">**S**</span><span style="color: #D7141A;">**A**</span>: [+ us_relation : relationships +]

<span style="color: #650C23;">**UK**</span>: [+ uk_relation : relationships +]

<span style="color: #1334A8;">**Fr**</span><span style="color: #D3D3D3;">**an**</span><span style="color: #E50000;">**ce**</span>: [+ france_relation : relationships +]

<span style="color: #000000;">**Bel**</span><span style="color: #D39E1C;">**gi**</span><span style="color: #DC143C;">**um**</span>: [+ belgium_relation : relationships +]

<span style="color: #E50000;">**Neth**</span><span style="color: #D3D3D3;">**erla**</span><span style="color: #325CAA;">**nds**</span>: [+ netherlands_relation : relationships +]


<span style="color: #F7F7F7;">**----------**</span>


<span style="color: #11457E;">**Eastern**</span> <span style="color: #D7141A;">**Neighbours**</span>: [+ east_relation : relationships +]

<span style="color: #DC143C;">**Pol**</span><span style="color: #D3D3D3;">**and**</span>: [+ poland_relation : relationships +]

<span style="color: #11457E;">**Czech**</span><span style="color: #D3D3D3;">**oslo**</span><span style="color: #D7141A;">**vakia**</span>: [+ czech_relation : relationships +]

<span style="color: #E5C517;">**Lit**</span><span style="color: #14810D;">**hua**</span><span style="color: #A50F0F;">**nia**</span>: [+ lithuania_relation : relationships +]

<span style="color: #DC143C;">**Au**</span><span style="color: #D3D3D3;">**str**</span><span style="color: #DC143C;">**ia**</span>: [+ austria_relation : relationships +]


<span style="color: #F7F7F7;">**---------**</span>


[? if ussr_formed = 1: <span style="color: #750e0e;">**USSR**</span>: [+ soviet_relation : relationships +] ?]

[? if ussr_formed = 0: <span style="color: #750e0e;">**RSFSR**</span>: [+ soviet_relation : relationships +] ?]

[? if vatican_independent: <span style="color: #FCF700;">**Vatican**</span><span style="color: #D3D3D3;">**City State**</span> [+ vatican_relation : relationships +] ?]

<span style="color: #1C470C;">**It**</span><span style="color: #D3D3D3;">**a**</span><span style="color: #DC143C;">**ly**</span>: [+ italy_relation : relationships +]

<span style="color: #EAD90C;">**Spain**</span>: [+ spain_relation : relationships +]


<span style="color: #F7F7F7;">**---------**</span>


<span style="color: #0CA0DD;">**Nordic**</span> <span style="color: #913232;">**Countries**</span>: [+ north_relation : relationships +]

<span style="color: #FF1F1F;">**D**</span><span style="color: #D3D3D3;">**e**</span><span style="color: #FF1F1F;">**nmark**</span>: [+ denmark_relation : relationships +]

<span style="color: #913232;">**N**</span><span style="color: #002654;">**o**</span><span style="color: #913232;">**rway**</span>: [+ norway_relation : relationships +]

<span style="color: #0CA0DD;">**S**</span><span style="color: #E5C517;">**w**</span><span style="color: #0CA0DD;">**eden**</span>: [+ sweden_relation : relationships +]

<span style="color: #D3D3D3;">**F**</span><span style="color: #1334A8;">**in**</span><span style="color: #D3D3D3;">**land**</span>: [+ finland_relation : relationships +]

<span style="color: #2B3B70;">**I**</span><span style="color: #A50F0F;">**c**</span><span style="color: #2B3B70;">**eland**</span>: [+ iceland_relation : relationships +]


@media

= Vorwärts

Current Editorial Line: [+ editorial_line +]

Factional bias: [+ factional_bias : dissent +]

Targeted enemy: [+ enemies +]

Agitation

Current primary objective: elections

= Media Landscape

<h4> <span style="color: #AA0000;">Left</span>: [+ left_media +]%

<span style="color: #00000f;">Anarchist media</span>: [+ anarchist_media +]%

<span style="color: [+ kpd_colour +];">Communist media</span>: [+ communist_media +]%

[? if editorial_line == "Left": <span style="color: [+ spd_colour +];">Socialist media</span>: [+ socdem_media +]% ?]

<h4> <span style="color: #000000;">Rep</span><span style="color: #DD0000;">upli</span><span style="color: #FFCC00;">can</span>: [+ republican_media +]%

<span style="color: #000000;">Catholic media</span>: [+ catholic_media +]%

[? if editorial_line == "Center": <span style="color: #c00000;">Socialist media</span>: [+ socdem_media +]% ?]
[? if editorial_line == "Labor": <span style="color: #c00000;">Socialist media</span>: [+ socdem_media +]% ?]
[? if editorial_line == "Reformists": <span style="color: #c00000;">Socialist media</span>: [+ socdem_media +]% ?]

<span style="color: #D3C24D;">Liberal media</span>: [+ liberal_media +]%

<h4> [? if year >= 1930: <span style="color: #000000;">Far</span> <span style="color: #D3D3D3;">Ri</span><span style="color: #A00000;">ght</span>?][? if year < 1929: <span style="color: #000000;">Ri</span><span style="color: #D3D3D3;">g</span><span style="color: #A00000;">ht</span>?]: [+ far_right_media +]%

<span style="color: [+ dvp_colour +];">Conservative media</span>: [+ conservative_media +]%

<span style="color: [+ dnvp_colour +];">Monarchist media</span>: [+ monarchist_media +]%

<span style="color: [+ nsdap_colour +];">Völkisch media</span>: [+ volkisch_media +]%

<span style="color: [+ i_colour +];">Other media</span>: [+ other_media +]%


@left

= Workers Parties

<span class="tooltip-text" title="Communist Party of Germany" style="color: [+ kpd_colour +];">**KPD**</span>: [+ kpd_relation : relationships +]

support: [+ kpd_votes +]%

Orientation: [+ kpd_ideology +] ([+ kpd_leader +])

Strategy: [+ kpd_strategy +]

[? if not uspd_joined = 3: <span class="tooltip-text" title="Independed Social Democratic Party of Germany" style="color: [+ uspd_colour +];">**USPD**</span>: [+ uspd_relation : relationships +] ?]

[? if not uspd_joined = 3: support: [+ uspd_votes +]% ?]

[? if not uspd_joined = 3: Orientation: [+ uspd_ideology +] ([+ uspd_leader +]) ?]

[? if sapd_formed: <span class="tooltip-text" title="Socialist Worker's Party of Germany" style="color: [+ sapd_colour +];">**SAPD**</span>: [+ sapd_relation : relationships +] ?]

[? if sapd_formed: support: [+ sapd_votes +]% ?]

[? if sapd_formed: Orientation: [+ sapd_ideology +] ([+ sapd_leader +]) ?]

[? if aspd_r: <span class="tooltip-text" title="Old Social Democratic Party of Germany" style="color: [+ aspd_colour +];">**ASPD**</span>: cool ?]

[? if aspd_r: support: [+ aspd_votes +]% ?]

[? if aspd_r: Orientation: [+ aspd_ideology +] ([+ aspd_leader +]) ?]

= Splinters

[? if kag_r > 0: <span class="tooltip-text" title="Communist Working Group" style="color: #81125B;">**KAG**</span>: <span style="color: #27F2DB;">cool</span> ?]

[? if kag_r > 0: influence: [+ kag_influence : influence +] ?]

[? if kag_r > 0: Orientation: Luxemburgism (Levi, Däumig) ?]

