view-if: anhalt_dvp == 1
on-arrival: anhalt_coalition_r = anhalt_coalition_r - dvp_r_anhalt; anhalt_dvp = 0
go-to: anhalt_coalition_creator

@anhalt_drop_kvp
view-if: anhalt_kvp == 1
on-arrival: anhalt_coalition_r = anhalt_coalition_r - kvp_r_anhalt; anhalt_kvp = 0
go-to: anhalt_coalition_creator

@anhalt_drop_vhg
