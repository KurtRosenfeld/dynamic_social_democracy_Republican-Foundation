       id="path29-86-9"
       cx="[+ soc_kag +]"
       cy="[+ rep_kag +]"
       inkscape:label="compass_party_kag"
       r="7">
      <title
         id="title39-1">KAG</title>
    </circle> ?]
    <circle
       style="fill:[+ kpd_colour +];fill-opacity:1;stroke:#000000;stroke-width:1.947;stroke-linejoin:miter;stroke-miterlimit:4;stroke-dasharray:none;stroke-opacity:1;paint-order:normal"
       id="path29-8"
