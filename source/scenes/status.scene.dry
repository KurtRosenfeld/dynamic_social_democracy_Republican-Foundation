[? if kpo_exists: Orientation: Bolshevism-Spartacism (Thalheimer) ?]

[? if leninbund_exists: <span class="tooltip-text" title="Leninbund (Left Communists)" style="color: #D00B0B;">**Leninbund**</span>: [+ leninbund_relation : relationships +] ?]

