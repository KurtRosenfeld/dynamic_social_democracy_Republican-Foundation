<div id="bavaria" style="width:500px; height:250px;"></div>






- @coalition_bavaria: Coalition
- @toleration_bavaria: Toleration
- @policies_bavaria: Policies
- @states: Exit Bavaria


@coalition_bavaria
choose-if: bavaria_spd == 1
unavailable-subtitle: We are not part of the Coalition

@toleration_bavaria
choose-if: bavaria_spd == 2
unavailable-subtitle: We are not in toleration

@policies_bavaria
choose-if: bavaria_spd == 1
unavailable-subtitle: We are not part of the Coalition







