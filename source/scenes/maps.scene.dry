    </circle>
 [? if not cvp_formed and not dnvp_dnef and not dnvp_defunct:  <circle
       style="fill:[+ dnvp_colour +];fill-opacity:1;stroke:#000000;stroke-width:1.947;stroke-linejoin:miter;stroke-miterlimit:4;stroke-dasharray:none;stroke-opacity:1;paint-order:normal"
       id="path29-7"
