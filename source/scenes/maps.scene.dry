       id="path29-8-1"
       cx="[+ soc_kpo +]"
       cy="[+ rep_kpo +]"
       inkscape:label="compass_party_kpo"
       r="7">
      <title
         id="title38-4">KPO</title>
    </circle> ?]
[? if leninbund_exists:  <circle
       style="fill:#a70000;fill-opacity:1;stroke:#000000;stroke-width:1.947;stroke-linejoin:miter;stroke-miterlimit:4;stroke-dasharray:none;stroke-opacity:1;paint-order:normal"
       id="path29-8-0"
       cx="[+ soc_leninbund +]"
       cy="[+ rep_leninbund +]"
