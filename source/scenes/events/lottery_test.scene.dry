title: Wanna play the lottery?
subtitle: This is only some test that does nothing real yet
view-if: year == 1922 and month == 4
max-visits: 1
priority: 8
tags: event
new-page: true
on-arrival: {!
  const WEIGHTS = {
    fleissner:   13,
    zeigner:     22,
    woytinsky:   10,
    baade:       11,
    heldt:       20,
    buck:        19,
    grzesinski:  15,
    hirschfeld:  13
  };

  // You have to a member to be voted in
  const ELIGIBLE = {
    fleissner:   Q.fleissner_in   === "SPD" && !Q.fleissner_picked,
    zeigner:     Q.zeigner_in    === "SPD" && !Q.zeigner_picked,
    woytinsky:   Q.woytinsky_in   === "SPD" && !Q.woytinsky_picked,
    baade:       Q.baade_in     === "SPD" && !Q.baade_picked,
    heldt:       Q.heldt_in === "SPD" && !Q.heldt_picked,
    buck:        Q.buck_in === "SPD" && !Q.buck_picked,
    grzesinski:  Q.grzesinski_in  === "SPD" && !Q.grzesinski_picked,
    hirschfeld:  Q.hirschfeld_in === "SPD" && !Q.hirschfled_picked
  };

  if (!Q.lottery_chosen) Q.lottery_chosen = [];

  const pool = Object.keys(WEIGHTS).filter(id =>
    ELIGIBLE[id] && !Q.lottery_chosen.includes(id)
  );

  // Join the commitee
  function pickWeighted(items) {
    const total = items.reduce((s, id) => s + WEIGHTS[id], 0);
    let r = Math.random() * total;
    for (let i = 0; i < items.length; i++) {
      r -= WEIGHTS[items[i]];
      if (r <= 0) return items.splice(i, 1)[0];
    }
    return items.pop();
  }

  // The newcomers
  const rolls = [];
  for (let i = 0; i < 3 && pool.length > 0; i++) {
    rolls.push(pickWeighted(pool));
  }

  Q.roll1 = rolls[0] || null;
  Q.roll2 = rolls[1] || null;
  Q.roll3 = rolls[2] || null;
!}

= Lottery - Test


[+ roll1 +]

[+ roll2 +]

[+ roll3 +]

