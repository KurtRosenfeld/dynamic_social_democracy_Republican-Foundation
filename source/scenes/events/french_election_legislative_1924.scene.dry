{!<tr><td><div class="box" style='background-color:#E0B0FF'> </div> !} <span class="tooltip-text" title="Republican, Radical and Radical-Socialist Party">PRRRS</span>: {!</td><td>!} [+ prrrs_assembly_vote +]% {!</td><td>!} [+ str_votes_change_prrrs_france +] {!</td><td>!} [+ disp_rad_assembly_r +]% {!</td><td>!} [+ str_change_prrrs_france +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#aa4fff'> </div> !} <span class="tooltip-text" title="Independent Radicals">RI</span>: {!</td><td>!} [+ i_rad_assembly_vote +]% {!</td><td>!} [+ str_votes_change_i_rad_france +] {!</td><td>!} [+ disp_ind_rad_assembly_r +]% {!</td><td>!} [+ str_change_i_rad_france +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#FFBF00'> </div> !} <span class="tooltip-text" title="Democratic Alliance">AD</span>: {!</td><td>!} [+ ad_assembly_vote +]% {!</td><td>!} [+ str_votes_change_ad_france +] {!</td><td>!} [+ ad_assembly_r +]% {!</td><td>!} [+ str_change_ad_france +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#00CCCC'> </div> !} <span class="tooltip-text" title="Popular Democratic Party">PDP</span>: {!</td><td>!} [+ pdp_assembly_vote +]% {!</td><td>!} [+ str_votes_change_pdp_france +] {!</td><td>!} [+ pdp_assembly_r +]% {!</td><td>!} [+ str_change_pdp_france +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#005ACA'> </div> !} <span class="tooltip-text" title=" Republican Federation">FR</span>: {!</td><td>!} [+ fr_assembly_vote +]% {!</td><td>!} [+ str_votes_change_fr_france +] {!</td><td>!} [+ disp_fr_assembly_r +]% {!</td><td>!} [+ str_change_fr_france +] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#ADC1FD'> </div> !} <span class="tooltip-text" title="Conservatives and Independents">Cons</span>: {!</td><td>!} [+ cons_assembly_vote +]% {!</td><td>!} [+ str_votes_change_cons_france +] {!</td><td>!} [+ cons_assembly_r +]% {!</td><td>!} [+ str_change_cons_france +] {!</td></tr>!}

