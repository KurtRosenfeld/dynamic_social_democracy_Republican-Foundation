title: Schaumburg-Lippe Landtag Election
view-if: (year == 1922 and month == 4 and not schaumburg_lippe_election_seen) or (schaumburg_lippe_election_2_trigger_time == time and schaumburg_lippe_election_seen_time != time)
new-page: true
tags: event
on-arrival: schaumburg_lippe_election_seen += 1 if schaumburg_lippe_election_seen; schaumburg_lippe_election_seen = 1 if not schaumburg_lippe_election_seen; schaumburg_lippe_election_seen_time = time; schaum_lippe_spd = 0; schaum_lippe_kpd = 0; schaum_lippe_uspd = 0; schaum_lippe_ddp = 0; schaum_lippe_true_others = 0; schaum_lippe_hb = 0; schaum_lippe_lvp = 0; schaum_lippe_lb = 0; schaum_lippe_cnbl = 0; schaumburg_lippe_dvp = 0; schaumburg_lippe_dnvp = 0; schaumburg_lippe_nsdap = 0
priority: 2
on-display: {!
var cardEl = document.createElement('div');
cardEl.className = "face-figure2";

var image = new Image();
image.className = "face-img";
image.src = "img/states.png";

cardEl.appendChild(image);
var contentDiv = document.querySelector("#page #mid_panel #content");
contentDiv.appendChild(cardEl);
!}

= Elections, [+ month : month +] [+ year +]

The Schaumburg-Lippe state elections are to be held now.

- @schaumburg_lippe: May we do our best...

@schaumburg_lippe
on-arrival: {!

var schaumburg_lippe_adjustment_factors = {
spd: 1.65,
uspd: 1.0,
kpd: 0.0,
ddp: 1.55,
lvp: 1.2,
dvp: 0.9,
dnvp: 0.63,
nsdap: 0.0,
nsfb: 0.0,
other: 1.4
};

Q.spd_r_schaumburg_lippe = 0;
Q.uspd_r_schaumburg_lippe = 0;
Q.kpd_r_schaumburg_lippe = 0;
Q.ddp_r_schaumburg_lippe = 0;
Q.lvp_r_schaumburg_lippe = 0;
Q.dvp_r_schaumburg_lippe = 0;
Q.dnvp_r_schaumburg_lippe = 0;
Q.nsdap_r_schaumburg_lippe = 0;
Q.nsfb_r_schaumburg_lippe = 0;
Q.other_r_schaumburg_lippe = 0;

Q.spd_schaumburg_lippe_elections_vote = 0;
Q.uspd_schaumburg_lippe_elections_vote = 0;
Q.kpd_schaumburg_lippe_elections_vote = 0;
Q.ddp_schaumburg_lippe_elections_vote = 0;
Q.lvp_schaumburg_lippe_elections_vote = 0;
Q.dvp_schaumburg_lippe_elections_vote = 0;
Q.dnvp_schaumburg_lippe_elections_vote = 0;
Q.nsdap_schaumburg_lippe_elections_vote = 0;
Q.nsfb_schaumburg_lippe_elections_vote = 0;
Q.other_schaumburg_lippe_elections_vote = 0;

if (Q.spd_votes < 30) schaumburg_lippe_adjustment_factors.spd += 0.1;
if (Q.spd_votes < 20) schaumburg_lippe_adjustment_factors.spd += 0.2;
if (Q.rural_spd_normalized >= 30) schaumburg_lippe_adjustment_factors.spd += 0.1;
Q.spd_schaumburg_lippe_elections_vote = Q.spd_votes*schaumburg_lippe_adjustment_factors.spd;
Q.uspd_schaumburg_lippe_elections_vote = Q.uspd_votes*schaumburg_lippe_adjustment_factors.uspd;
if (Q.year >= 1925) schaumburg_lippe_adjustment_factors.kpd += 0.3;
Q.kpd_schaumburg_lippe_elections_vote = Q.kpd_votes*schaumburg_lippe_adjustment_factors.kpd;
Q.ddp_schaumburg_lippe_elections_vote = Q.ddp_votes*schaumburg_lippe_adjustment_factors.ddp;
Q.lvp_schaumburg_lippe_elections_vote = Q.lvp_votes*schaumburg_lippe_adjustment_factors.lvp;
if (Q.dvp_votes < 6) schaumburg_lippe_adjustment_factors.dvp += 0.1;
Q.dvp_schaumburg_lippe_elections_vote = Q.dvp_votes*schaumburg_lippe_adjustment_factors.dvp;
if (Q.year >= 1923) schaumburg_lippe_adjustment_factors.dnvp += 0.4;
Q.dnvp_schaumburg_lippe_elections_vote = Q.dnvp_votes*schaumburg_lippe_adjustment_factors.dnvp;
if (Q.nsdap_votes >= 20) schaumburg_lippe_adjustment_factors.nsdap += 0.55;
Q.nsdap_schaumburg_lippe_elections_vote = Q.nsdap_votes*schaumburg_lippe_adjustment_factors.nsdap;
Q.nsfb_schaumburg_lippe_elections_vote = Q.nsfb_votes*schaumburg_lippe_adjustment_factors.nsfb;
if (Q.nsdap_votes >= 20) schaumburg_lippe_adjustment_factors.other -= 0.8;
Q.other_schaumburg_lippe_elections_vote = Q.other_votes*schaumburg_lippe_adjustment_factors.other;

Q.total_votes_schaumburg_lippe = Q.spd_schaumburg_lippe_elections_vote + Q.kpd_schaumburg_lippe_elections_vote + Q.ddp_schaumburg_lippe_elections_vote + Q.lvp_schaumburg_lippe_elections_vote + Q.dvp_schaumburg_lippe_elections_vote + Q.dnvp_schaumburg_lippe_elections_vote + Q.nsdap_schaumburg_lippe_elections_vote + Q.other_schaumburg_lippe_elections_vote + Q.uspd_schaumburg_lippe_elections_vote + Q.nsfb_schaumburg_lippe_elections_vote;

if (Q.total_votes_schaumburg_lippe > 0) {
Q.spd_schaumburg_lippe_elections_vote = (Q.spd_schaumburg_lippe_elections_vote / Q.total_votes_schaumburg_lippe) * 100;
Q.uspd_schaumburg_lippe_elections_vote = (Q.uspd_schaumburg_lippe_elections_vote / Q.total_votes_schaumburg_lippe) * 100;
Q.kpd_schaumburg_lippe_elections_vote = (Q.kpd_schaumburg_lippe_elections_vote / Q.total_votes_schaumburg_lippe) * 100;
Q.ddp_schaumburg_lippe_elections_vote = (Q.ddp_schaumburg_lippe_elections_vote / Q.total_votes_schaumburg_lippe) * 100;
Q.lvp_schaumburg_lippe_elections_vote = (Q.lvp_schaumburg_lippe_elections_vote / Q.total_votes_schaumburg_lippe) * 100;
Q.dvp_schaumburg_lippe_elections_vote = (Q.dvp_schaumburg_lippe_elections_vote / Q.total_votes_schaumburg_lippe) * 100;
Q.dnvp_schaumburg_lippe_elections_vote = (Q.dnvp_schaumburg_lippe_elections_vote / Q.total_votes_schaumburg_lippe) * 100;
Q.nsdap_schaumburg_lippe_elections_vote = (Q.nsdap_schaumburg_lippe_elections_vote / Q.total_votes_schaumburg_lippe) * 100;
Q.other_schaumburg_lippe_elections_vote = (Q.other_schaumburg_lippe_elections_vote / Q.total_votes_schaumburg_lippe) * 100;
Q.nsfb_schaumburg_lippe_elections_vote = (Q.nsfb_schaumburg_lippe_elections_vote / Q.total_votes_schaumburg_lippe) * 100;
}

Q.spd_schaumburg_lippe_elections_vote = (Q.spd_schaumburg_lippe_elections_vote != undefined ? parseFloat(Q.spd_schaumburg_lippe_elections_vote.toFixed(1)) : 0);
Q.uspd_schaumburg_lippe_elections_vote = (Q.uspd_schaumburg_lippe_elections_vote != undefined ? parseFloat(Q.uspd_schaumburg_lippe_elections_vote.toFixed(1)) : 0);
Q.kpd_schaumburg_lippe_elections_vote = (Q.kpd_schaumburg_lippe_elections_vote != undefined ? parseFloat(Q.kpd_schaumburg_lippe_elections_vote.toFixed(1)) : 0);
Q.ddp_schaumburg_lippe_elections_vote = (Q.ddp_schaumburg_lippe_elections_vote != undefined ? parseFloat(Q.ddp_schaumburg_lippe_elections_vote.toFixed(1)) : 0);
Q.lvp_schaumburg_lippe_elections_vote = (Q.lvp_schaumburg_lippe_elections_vote != undefined ? parseFloat(Q.lvp_schaumburg_lippe_elections_vote.toFixed(1)) : 0);
Q.dvp_schaumburg_lippe_elections_vote = (Q.dvp_schaumburg_lippe_elections_vote != undefined ? parseFloat(Q.dvp_schaumburg_lippe_elections_vote.toFixed(1)) : 0);
Q.dnvp_schaumburg_lippe_elections_vote = (Q.dnvp_schaumburg_lippe_elections_vote != undefined ? parseFloat(Q.dnvp_schaumburg_lippe_elections_vote.toFixed(1)) : 0);
Q.nsdap_schaumburg_lippe_elections_vote = (Q.nsdap_schaumburg_lippe_elections_vote != undefined ? parseFloat(Q.nsdap_schaumburg_lippe_elections_vote.toFixed(1)) : 0);
Q.other_schaumburg_lippe_elections_vote = (Q.other_schaumburg_lippe_elections_vote != undefined ? parseFloat(Q.other_schaumburg_lippe_elections_vote.toFixed(1)) : 0);
Q.nsfb_schaumburg_lippe_elections_vote = (Q.nsfb_schaumburg_lippe_elections_vote != undefined ? parseFloat(Q.nsfb_schaumburg_lippe_elections_vote.toFixed(1)) : 0);

if (Q.spd_schaumburg_lippe_elections_vote >= 3.7) Q.spd_r_schaumburg_lippe = Q.spd_schaumburg_lippe_elections_vote;
if (Q.uspd_schaumburg_lippe_elections_vote >= 3.7) Q.uspd_r_schaumburg_lippe = Q.uspd_schaumburg_lippe_elections_vote;
if (Q.kpd_schaumburg_lippe_elections_vote >= 4.0) Q.kpd_r_schaumburg_lippe = Q.kpd_schaumburg_lippe_elections_vote;
if (Q.ddp_schaumburg_lippe_elections_vote >= 3.7) Q.ddp_r_schaumburg_lippe = Q.ddp_schaumburg_lippe_elections_vote;
if (Q.lvp_schaumburg_lippe_elections_vote >= 3.7) Q.lvp_r_schaumburg_lippe = Q.lvp_schaumburg_lippe_elections_vote;
if (Q.dvp_schaumburg_lippe_elections_vote >= 3.7) Q.dvp_r_schaumburg_lippe = Q.dvp_schaumburg_lippe_elections_vote;
if (Q.dnvp_schaumburg_lippe_elections_vote >= 3.2) Q.dnvp_r_schaumburg_lippe = Q.dnvp_schaumburg_lippe_elections_vote;
if (Q.nsdap_schaumburg_lippe_elections_vote >= 3.6) Q.nsdap_r_schaumburg_lippe = Q.nsdap_schaumburg_lippe_elections_vote;
if (Q.other_schaumburg_lippe_elections_vote >= 3.9) Q.other_r_schaumburg_lippe = Q.other_schaumburg_lippe_elections_vote;
if (Q.nsfb_schaumburg_lippe_elections_vote >= 3.5) Q.nsfb_r_schaumburg_lippe = Q.nsfb_schaumburg_lippe_elections_vote;

var schaumburg_lippe_adjustment_r_factors = {
spd: 1.0,
uspd: 1.0,
kpd: 0.99,
ddp: 1.0,
lvp: 1.0,
dvp: 1.0,
dnvp: 1.0,
nsdap: 1.0,
other: 1.0,
nsfb: 1.0
};


Q.spd_r_schaumburg_lippe = Q.spd_r_schaumburg_lippe * schaumburg_lippe_adjustment_r_factors.spd;
Q.uspd_r_schaumburg_lippe = Q.uspd_r_schaumburg_lippe * schaumburg_lippe_adjustment_r_factors.uspd;
Q.kpd_r_schaumburg_lippe = Q.kpd_r_schaumburg_lippe * schaumburg_lippe_adjustment_r_factors.kpd;
Q.ddp_r_schaumburg_lippe = Q.ddp_r_schaumburg_lippe * schaumburg_lippe_adjustment_r_factors.ddp;
Q.lvp_r_schaumburg_lippe = Q.lvp_r_schaumburg_lippe * schaumburg_lippe_adjustment_r_factors.lvp;
Q.dvp_r_schaumburg_lippe = Q.dvp_r_schaumburg_lippe * schaumburg_lippe_adjustment_r_factors.dvp;
Q.dnvp_r_schaumburg_lippe = Q.dnvp_r_schaumburg_lippe * schaumburg_lippe_adjustment_r_factors.dnvp;
Q.nsdap_r_schaumburg_lippe = Q.nsdap_r_schaumburg_lippe * schaumburg_lippe_adjustment_r_factors.nsdap;
Q.other_r_schaumburg_lippe = Q.other_r_schaumburg_lippe * schaumburg_lippe_adjustment_r_factors.other;
Q.nsfb_r_schaumburg_lippe = Q.nsfb_r_schaumburg_lippe * schaumburg_lippe_adjustment_r_factors.nsfb;

Q.total_r_schaumburg_lippe = 0;

if (Q.spd_r_schaumburg_lippe) Q.total_r_schaumburg_lippe += Q.spd_r_schaumburg_lippe;
if (Q.uspd_r_schaumburg_lippe) Q.total_r_schaumburg_lippe += Q.uspd_r_schaumburg_lippe;
if (Q.kpd_r_schaumburg_lippe) Q.total_r_schaumburg_lippe += Q.kpd_r_schaumburg_lippe;
if (Q.ddp_r_schaumburg_lippe) Q.total_r_schaumburg_lippe += Q.ddp_r_schaumburg_lippe;
if (Q.lvp_r_schaumburg_lippe) Q.total_r_schaumburg_lippe += Q.lvp_r_schaumburg_lippe;
if (Q.dvp_r_schaumburg_lippe) Q.total_r_schaumburg_lippe += Q.dvp_r_schaumburg_lippe;
if (Q.dnvp_r_schaumburg_lippe) Q.total_r_schaumburg_lippe += Q.dnvp_r_schaumburg_lippe;
if (Q.nsdap_r_schaumburg_lippe) Q.total_r_schaumburg_lippe += Q.nsdap_r_schaumburg_lippe;
if (Q.other_r_schaumburg_lippe) Q.total_r_schaumburg_lippe += Q.other_r_schaumburg_lippe;
if (Q.nsfb_r_schaumburg_lippe) Q.total_r_schaumburg_lippe += Q.nsfb_r_schaumburg_lippe;

if (Q.total_r_schaumburg_lippe > 0) {
Q.spd_r_schaumburg_lippe = (Q.spd_r_schaumburg_lippe / Q.total_r_schaumburg_lippe) * 100;
Q.uspd_r_schaumburg_lippe = (Q.uspd_r_schaumburg_lippe / Q.total_r_schaumburg_lippe) * 100;
Q.kpd_r_schaumburg_lippe = (Q.kpd_r_schaumburg_lippe / Q.total_r_schaumburg_lippe) * 100;
Q.ddp_r_schaumburg_lippe = (Q.ddp_r_schaumburg_lippe / Q.total_r_schaumburg_lippe) * 100;
Q.lvp_r_schaumburg_lippe = (Q.lvp_r_schaumburg_lippe / Q.total_r_schaumburg_lippe) * 100;
Q.dvp_r_schaumburg_lippe = (Q.dvp_r_schaumburg_lippe / Q.total_r_schaumburg_lippe) * 100;
Q.dnvp_r_schaumburg_lippe = (Q.dnvp_r_schaumburg_lippe / Q.total_r_schaumburg_lippe) * 100;
Q.nsdap_r_schaumburg_lippe = (Q.nsdap_r_schaumburg_lippe / Q.total_r_schaumburg_lippe) * 100;
Q.other_r_schaumburg_lippe = (Q.other_r_schaumburg_lippe / Q.total_r_schaumburg_lippe) * 100;
Q.nsfb_r_schaumburg_lippe = (Q.nsfb_r_schaumburg_lippe / Q.total_r_schaumburg_lippe) * 100;
}

let cnbl_share = 0.0;
if (Q.cnbl_exists) cnbl_share += 0.8
let true_other_share = 0.25;
if (Q.year >= 1929) true_other_share -= 0.2;
let hb_share = 0.36;
if (Q.president == "Hindenburg") hb_share -= 0.36;
let lb_share = 0.39;
if (Q.cnbl_exists) lb_share -= 0.39;


let total_share = cnbl_share + hb_share + true_other_share + lb_share;

cnbl_share = (cnbl_share / total_share);
hb_share = (hb_share / total_share);
lb_share = (lbvrp_share / total_share);
true_other_share = (true_other_share / total_share);

Q.cnbl_schaumburg_lippe_elections_vote = Q.other_schaumburg_lippe_elections_vote*cnbl_share;
Q.cnbl_r_schaumburg_lippe = Q.other_r_schaumburg_lippe*cnbl_share;

Q.lb_schaumburg_lippe_elections_vote = Q.other_schaumburg_lippe_elections_vote*lb_share;
Q.lb_r_schaumburg_lippe = Q.other_r_schaumburg_lippe*lb_share;

Q.hb_schaumburg_lippe_elections_vote = Q.other_schaumburg_lippe_elections_vote*hb_share;
Q.hb_r_schaumburg_lippe = Q.other_r_schaumburg_lippe*hb_share;

Q.true_other_schaumburg_lippe_elections_vote = Q.other_schaumburg_lippe_elections_vote*true_other_share;
Q.true_other_r_schaumburg_lippe = Q.other_r_schaumburg_lippe*true_other_share;

function allocateSeats(percentages, totalSeats = 15) {
const exactSeats = {};
const flooredSeats = {};
const remainders = [];

let totalFlooredSeats = 0;
for (const party in percentages) {
const exact = (percentages[party] * totalSeats) / 100;
const floored = Math.floor(exact);
const remainder = exact - floored;

exactSeats[party] = exact;
flooredSeats[party] = floored;
totalFlooredSeats += floored;

remainders.push({ party, remainder });
}

const seatsToDistribute = totalSeats - totalFlooredSeats;
remainders.sort((a, b) => b.remainder - a.remainder);

for (let i = 0; i < seatsToDistribute; i++) {
flooredSeats[remainders[i].party]++;
}

return flooredSeats;
}

const inputPercentages = {
spd_r_schaumburg_lippe: Q.spd_r_schaumburg_lippe,
uspd_r_schaumburg_lippe: Q.uspd_r_schaumburg_lippe,
kpd_r_schaumburg_lippe: Q.kpd_r_schaumburg_lippe,
ddp_r_schaumburg_lippe: Q.ddp_r_schaumburg_lippe,
lvp_r_schaumburg_lippe: Q.lvp_r_schaumburg_lippe,
dvp_r_schaumburg_lippe: Q.dvp_r_schaumburg_lippe,
dnvp_r_schaumburg_lippe: Q.dnvp_r_schaumburg_lippe,
nsdap_r_schaumburg_lippe: Q.nsdap_r_schaumburg_lippe,
hb_r_schaumburg_lippe: Q.hb_r_schaumburg_lippe,
lb_r_schaumburg_lippe: Q.lb_r_schaumburg_lippe,
cnbl_r_schaumburg_lippe: Q.cnbl_r_schaumburg_lippe,
true_other_r_schaumburg_lippe: Q.true_other_r_schaumburg_lippe,
nsfb_r_schaumburg_lippe: Q.nsfb_r_schaumburg_lippe
};

const allocatedSeats = allocateSeats(inputPercentages);

for (const party in allocatedSeats) {
Q[party] = parseFloat(((allocatedSeats[party] * 100) / 15).toFixed(1));
}

Q.other_r_schaumburg_lippe = Q.true_other_r_schaumburg_lippe + Q.hb_r_schaumburg_lippe + Q.lb_r_schaumburg_lippe + Q.cnbl_r_schaumburg_lippe;

if (Q.year == 1925) Q.rl_schaumburg_lippe_elections_votes = (Q.dnvp_schaumburg_lippe_elections_votes + Q.dvp_schaumburg_lippe_elections_votes + Q.lb_schaumburg_lippe_elections_votes);             
if (Q.year == 1925) Q.rl_r_schaumburg_lippe = (Q.dnvp_r_schaumburg_lippe + Q.dvp_r_schaumburg_lippe + Q.lb_r_schaumburg_lippe);
if (Q.rl_r_schaumburg_lippe) Q.dnvp_r_schaumburg_lippe = 0;
if (Q.rl_r_schaumburg_lippe) Q.dvp_r_schaumburg_lippe = 0;
if (Q.rl_r_schaumburg_lippe) Q.lb_r_schaumburg_lippe = 0;
             
Q.left_coalition_schaumburg_lippe = parseFloat((Q.spd_r_schaumburg_lippe + Q.kpd_r_schaumburg_lippe + Q.uspd_r_schaumburg_lippe).toFixed(1));
Q.dvp_coalition_schaumburg_lippe = parseFloat((Q.lvp_r_schaumburg_lippe + Q.dvp_r_schaumburg_lippe + Q.dnvp_r_schaumburg_lippe + Q.dnvp_r_schaumburg_lippe + Q.other_r_schaumburg_lippe + Q.rl_r_schaumburg_lippe).toFixed(1));
Q.right_coalition_schaumburg_lippe = parseFloat((Q.dnvp_r_schaumburg_lippe + Q.dvp_r_schaumburg_lippe + Q.nsdap_r_schaumburg_lippe + Q.other_r_schaumburg_lippe + Q.nsfb_r_schaumburg_lippe).toFixed(1));
Q.socmon_coalition_schaumburg_lippe = parseFloat((Q.lvp_r_schaumburg_lippe + Q.dvp_r_schaumburg_lippe + Q.dnvp_r_schaumburg_lippe + Q.lb_r_schaumburg_lippe + Q.dnvp_r_schaumburg_lippe + Q.ddp_r_schaumburg_lippe + Q.spd_r_schaumburg_lippe + Q.rl_r_schaumburg_lippe).toFixed(1));

Q.hb_schaumburg_lippe_elections_vote = (Q.hb_schaumburg_lippe_elections_vote != undefined ? parseFloat(Q.hb_schaumburg_lippe_elections_vote.toFixed(1)) : 0);
Q.true_other_schaumburg_lippe_elections_vote = (Q.true_other_schaumburg_lippe_elections_vote != undefined ? parseFloat(Q.true_other_schaumburg_lippe_elections_vote.toFixed(1)) : 0);
Q.lb_schaumburg_lippe_elections_vote = (Q.lb_schaumburg_lippe_elections_vote != undefined ? parseFloat(Q.lb_schaumburg_lippe_elections_vote.toFixed(1)) : 0);
Q.cnbl_schaumburg_lippe_elections_vote = (Q.cnbl_schaumburg_lippe_elections_vote != undefined ? parseFloat(Q.cnbl_schaumburg_lippe_elections_vote.toFixed(1)) : 0);
Q.hb_r_schaumburg_lippe = (Q.hb_r_schaumburg_lippe != undefined ? parseFloat(Q.hb_r_schaumburg_lippe.toFixed(1)) : 0);
Q.true_other_r_schaumburg_lippe = (Q.true_other_r_schaumburg_lippe != undefined ? parseFloat(Q.true_other_r_schaumburg_lippe.toFixed(1)) : 0);
Q.lb_r_schaumburg_lippe = (Q.lb_r_schaumburg_lippe != undefined ? parseFloat(Q.lb_r_schaumburg_lippe.toFixed(1)) : 0);
Q.cnbl_r_schaumburg_lippe = (Q.farm_r_schaumburg_lippe != undefined ? parseFloat(Q.cnbl_r_schaumburg_lippe.toFixed(1)) : 0);             
             
!}
on-display: {!
data = [{
"id": "kpd",
"legend": "KPD",
"name": "KPD",
"seats": Math.round(Q.kpd_r_schaumburg_lippe * 0.15),
}];


if (Q.uspd_r_schaumburg_lippe) {
data.push({
"id": "uspd",
"legend": "USPD",
"name": "USPD",
"seats": Math.round(Q.uspd_r_schaumburg_lippe * 0.15),
});
}

data = data.concat([{
"id": "spd",
"legend": "SPD",
"name": "SPD",
"seats": Math.round(Q.spd_r_schaumburg_lippe * 0.15),
}]);

if (Q.ddp_r_schaumburg_lippe && !Q.lvp_formed) {
data.push({
"id": "ddp",
"legend": Q.ddp_name,
"name": Q.ddp_name,
"seats": Math.round(Q.ddp_r_schaumburg_lippe * 0.15),
});
}

if (Q.lvp_r_schaumburg_lippe && Q.lvp_formed) {
data.push({
"id": "lvp",
"legend": "LVP",
"name": "LVP",
"seats": Math.round(Q.lvp_r_schaumburg_lippe * 0.15),
});
}

if (Q.hb_r_schaumburg_lippe) {
data.push({
"id": "aspd",
"legend": "HB",
"name": "HB",
"seats": Math.round(Q.hb_r_schaumburg_lippe * 0.15),
});
}

if (Q.dvp_r_schaumburg_lippe && !Q.lvp_formed && Q.dvp_exist) {
data.push({
"id": "dvp",
"legend": "DVP",
"name": "DVP",
"seats": Math.round(Q.dvp_r_schaumburg_lippe * 0.15),
});
}
                          
if (Q.true_other_r_schaumburg_lippe) {
data.push({
"id": "other",
"legend": "Other",
"name": "Others",
"seats": Math.round(Q.true_other_r_schaumburg_lippe * 0.15),
});
}

if (Q.cnbl_r_schaumburg_lippe) {
data.push({
"id": "farm3",
"legend": "CNBL",
"name": "CNBL",
"seats": Math.round(Q.farm_r_schaumburg_lippe * 0.15),
});
}

if (Q.lb_r_schaumburg_lippe) {
data.push({
"id": "farm2",
"legend": "LB",
"name": "LB",
"seats": Math.round(Q.lb_r_schaumburg_lippe * 0.15),
});
}             
             
if (Q.dnvp_r_schaumburg_lippe) {
data.push({
"id": "dnvp",
"legend": "DNVP",
"name": "DNVP",
"seats": Math.round(Q.dnvp_r_schaumburg_lippe * 0.15),
});
}    

if (Q.rl_r_schaumburg_lippe) {
data.push({
"id": "rl",
"legend": "RL",
"name": "RL",
"seats": Math.round(Q.rl_r_schaumburg_lippe * 0.15),
});
}    
             

data.push({
"id": "nsfb",
"legend": "NSFB",
"name": "NSFB",
"seats": Math.round(Q.nsfb_r_schaumburg_lippe * 0.15),
});

data = data.concat([{
"id": "nsdap",
"legend": "NSDAP",
"name": "NSDAP",
"seats": Math.round(Q.nsdap_r_schaumburg_lippe * 0.15),
}]);

if (window && d3) {
var width = 500;
var height = 500;
var screenWidth = document.getElementById('content').offsetWidth;
if (screenWidth < width - 50) {
width = screenWidth - 50;
height = width;
document.getElementById("schaumburg_lippe_landtag").style.height = screenWidth/2 + "px";
}
var parliament = d3.parliament();
parliament.width(width).height(height).innerRadiusCoef(0.4);
parliament.enter.fromCenter(true).smallToBig(true);
parliament.exit.toCenter(false).bigToSmall(true);
d3.select("#schaumburg_lippe_landtag").datum(data).call(parliament);
}
!}
