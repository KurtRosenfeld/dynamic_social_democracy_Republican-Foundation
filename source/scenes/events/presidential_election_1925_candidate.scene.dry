@abandon_unity_kpd
view-if: kpd_unity_support == 1
subtitle: The KPD would be outraged!
on-arrival: kpd_prescan = "Thälmann"; kpd_relation -= 12; uspd_relation -= 7; sb_relation -= 10; workers_spd -= 5; unemployed_spd -= 3
go-to: spd_alone


@abandon_unity
view-if: kpd_unity_support == 0
subtitle: Since the KPD does not support unity, we might as well not either.
on-arrival: uspd_relation -= 4; sb_relation -= 7
go-to: spd_alone


@spd_alone
view-if: ledebour_unity_candidate == 0 and rosenfeld_unity_candidate == 0

[? if rosenfeld_in == "SPD":
<div style="display: flex; align-items: flex-start; gap: 1em; margin-bottom: 1em;"> <img src="img/portraits/RosenfeldKurt.jpg" style="width: 100%; max-width: 190px; cursor : pointer;"/>  <div>Rosenfeld is a lawyer and established politician in the outer left of our party. His politics are marked by clear opposition to cooperation with the Bourgeois parties and sympathy for the KPD.<br/> Faction: Left </div> </div> ?]

[? if scheidemann_in == "SPD":
<div style="display: flex; align-items: flex-start; gap: 1em; margin-bottom: 1em;"> <img src="img/portraits/ScheidemannPhilipp.jpg" style="width: 100%; max-width: 190px; cursor : pointer;"/>  <div>Scheidemann used to be both party leader and then Chancellor, in 1919 he even ran against Ebert for the presidential office. His politics are perfectly aligned with those of the centrist faction arguing for cooperation with the DVP when necessary but maintaining the principles of Marx.<br/> Faction: Center </div> </div> ?]

[? if scheidemann_in == "SPD":
<div style="display: flex; align-items: flex-start; gap: 1em; margin-bottom: 1em;"> <img src="img/portraits/BraunOtto.jpg" style="width: 100%; max-width: 190px; cursor : pointer;"/>  <div>[? prussia_leader == "Braun": Otto Braun doesn't want to run. Yet still his supporters value that he is already well known accross the Reich and mirrors Ebert's pragmatic politics (despite being a little more to the party center than him) ?][? prussia_leader == "Braun": Braun  is already well known accross the Reich and mirrors Ebert's pragmatic politics (despite being a little more to the party center than him) ?].<br/> Faction: Reformist </div> </div> ?]


- @rosenfeld_spd_run: Run Kurt Rosenfeld
- @scheidemann_run: Run Philipp Scheidemann
- @braun_run: Run Otto Braun
- @dont_run_anyone: Don't run anyone


@rosenfeld_spd_run
subtitle: He is the preferred candidate of the left.
choose-if: left_strength >= 65 or spd_party_leader_3 == "Rosenfeld"
unavailable-subtitle: Rosenfeld is too left-wing for the party
on-arrival: spd_prescan = "Rosenfeld"
go-to: view_running_candidates


@scheidemann_run
subtitle: He is quite experienced and appeals to our center.
choose-if: center_strength >= 50 or scheidemann_advisor == 1
unavailable-subtitle: Scheidemann is just too old and boring.
on-arrival: spd_prescan = "Rosenfeld"
go-to: view_running_candidates


@braun_run
subtitle: He actually doesn't want to run but his qualification speaks for itself.
choose-if: reformist_strength > left_strength or prussia_leader == "Braun"
unavailable-subtitle: Braun is considered too right-wing by most party members.
on-arrival: spd_prescan = "Rosenfeld"
go-to: view_running_candidates


@dont_run_anyone
subtitle: Just endorse whoever our friends are running. This could save us costs...
on-arrival: no_spd_participation = 1
go-to: view_running_candidates


