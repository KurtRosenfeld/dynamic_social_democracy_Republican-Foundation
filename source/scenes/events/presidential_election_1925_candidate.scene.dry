[? if proletarian_prescan: <span style="color: [+ uspd_colour +];">**USPD**</span> and ledebour_unity_candidate: <span style="color: [+ ledebour_colour +];">**Ledebour**</span> ?]

[? if proletarian_prescan: <span style="color: [+ uspd_colour +];">**USPD**</span> and rosenfeld_unity_candidate: <span style="color: [+ roisenfeld_colour +];">**Rosenfeld**</span> ?]

[? if sb_exists and not proletarian_prescan: <span style="color: [+ uspd_colour +];">**USPD**</span>: <span style="color: [+ kpd_colour +];">**[+ kpd_prescan +]**</span> ?]

<span style="color: #3A0000;">**KAPD**</span>: abstain


</div>

<script>
  let click_br_lowp = 0;
  document.getElementById('mother-lowp').addEventListener('click', () => {
    click_br_wo = 1 - click_br_lowp;
    document.getElementById('break-lowp').style.display = click_br_lowp ? 'block' : 'none';
  });
</script>


