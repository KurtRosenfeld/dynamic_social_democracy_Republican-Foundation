title: colour settings
new-page: true
is-special: true
go-to: jimmy

= Colour Settings

Here colours for partys can be adapted (massively work in progress)

@jimmy

- @spd_design: <span style="color: [+ spd_colour +];">**SPD**</span>
- @uspd_design: <span style="color: [+ uspd_colour +];">**USPD**</span>
- @dvp_design: <span style="color: [+ dvp_colour +];">**DVP**</span>
- @dnvp_design: <span style="color: [+ dnvp_colour +];">**DNVP**</span>


@spd_design

- @boring_ass_spd: <span style="color: #c00000;">**SPD**</span>
- @spd_uspd_red: <span style="color: #B3133A;">**SPD**</span>
- @spd_whatever_idk: <span style="color: #670000;">**SPD**</span>
- @spd_purple: <span style="color: #652593;">**SPD**</span>
- @spd_orange: <span style="color: #DD9B24;">**SPD**</span>
- @disable_spd_c: Disable dynamic changes
- @enable_spd_cc: Enable dynamic changes

@boring_ass_spd
on-arrival: spd_colour = "#c00000"
go-to: jimmy

@spd_uspd_red
on-arrival: spd_colour = "#B3133A"
go-to: jimmy

@spd_whatever_idk
on-arrival: spd_colour = "#670000"
go-to: jimmy

@spd_purple
on-arrival: spd_colour = '#652593'
go-to: jimmy

@spd_orange 
on-arrival: spd_colour = '#DD9B24'
go-to: jimmy


@disable_spd_c
subtitle: Events can change a party's colour - this option retains the chosen colour for the entire game
on-arrival: no_spd_cc = 1
view-if: no_spd_cc == 0
go-to: jimmy

@enable_spd_cc
on-arrival: no_spd_cc = 0
view-if: no_spd_cc == 1
go-to: jimmy

@uspd_design


- @disable_uspd_c_2: Disable secondary colour


- @uspd_pink: <span style="color: #D47B9B;">**USPD**</span>
- @uspd_lavender: <span style="color: #B790D3;">**USPD**</span>
- @uspd_red: <span style="color: #AA0000;">**USPD**</span>
- @uspd_other_red: <span style="color: #B3133A;">**USPD**</span>
- @disable_uspd_c: Disable dynamic changes
- @enable_uspd_cc: Enable dynamic changes

@uspd_pink
on-arrival: uspd_colour = "#D47B9B"
go-to: jimmy

@uspd_lavender
on-arrival: uspd_colour = "#B790D3"
go-to: jimmy

@uspd_red
on-arrival: uspd_colour = "#AA0000"
go-to: jimmy
  
@uspd_other_red
on-arrival: uspd_colour = "#B3133A"
go-to: jimmy
  
  

@disable_uspd_c
subtitle: Events can change a party's colour - this option retains the chosen colour for the entire game
on-arrival: no_uspd_cc = 1
view-if: no_uspd_cc == 0
go-to: jimmy

@enable_uspd_cc
on-arrival: no_uspd_cc = 0
view-if: no_uspd_cc == 1
go-to: jimmy

@dvp_design
choose-if: giga_achievment_tier_2
unavailable-subtitle: reserved for achievements (wip)


@dnvp_design
choose-if: giga_achievment_tier_2
unavailable-subtitle: reserved for achievements (wip) 





  




  
