@center
on-arrival: {!

if (Q.chancellor !== "Marx") Q.marx_run_1925;
if (!Q.marx_run_1925 && Q.workers_z >= 12) Q.stegerwald_run_1925;
if (!Q.marx_run_1925 && Q.workers_z < 12) Q.hermes_run_1925;

!}

- @marx_run: Wilhelm Marx
- @stegerwald_run: Adam Stegerwald
- @hermes_run: Andreas Hermes

@marx_run
