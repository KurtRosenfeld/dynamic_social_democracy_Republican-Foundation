[? if aspd_r_saxony and aspd_r == 0: influence: [+ aspd_influence : influence +] ?]

[? if aspd_r_saxony and aspd_r == 0: Orientation: National Social Democracy (Heldt) ?]

[? if kpo_exists: <span class="tooltip-text" title="Communist Party Opposition" style="color: #C43988;">**KPO**</span>: [+ kpo_relation : relationships +] ?]

