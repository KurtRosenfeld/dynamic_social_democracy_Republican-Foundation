[? if reichsblock_prescan: - <span style="color: #b8996f;">**WP**</span> ?]


[? if proletarian_prescan == "Georg Ledebour": <span style="color: [+ ledebour_colour +];">**Georg Ledebour**</span> ?][? if proletarian_prescan == "Kurt Rosenfeld": <span style="color: [+ rosenfeld_colour +];">**Kurt Rosenfeld**</span> ?]

[? if proletarian_prescan: - <span style="color: [+ spd_colour +];">**SPD**</span> ?]

[? if kpd_unity_support == 1: - <span style="color: [+ kpd_colour +];">**KPD**</span> ?]

[? if proletarian_prescan == "Ledebour" and ledebour_in == "USPD": - <span style="color: [+ uspd_colour +];">**USPD**</span> ?]

[? if proletarian_prescan == "Rosenfeld" and rosenfeld_in == "USPD": - <span style="color: [+ uspd_colour +];">**USPD**</span> ?]

[? if proletarian_prescan == "Ledebour" and ledebour_in == "SB": - <span style="color: [+ sb_colour +];">**SB**</span> ?]

[? if proletarian_prescan == "Rosenfeld" and rosenfeld_in == "SB": - <span style="color: [+ sb_colour +];">**SB**</span> ?]


[? if spd_prescan: <span style="color: [+ spd_colour +];">**[+ spd_prescan +]**</span> ?]

[? if spd_prescan: - <span style="color: [+ spd_colour +];">**SPD**</span> ?]


[? if spd_support_simons == 1: <span style="color: [+ other_colour +];">**Walter Simons**</span> ?]

[? if spd_support_simons == 1: - <span style="color: [+ spd_colour +];">**SPD**</span> ?]

[? if spd_support_simons == 1: - <span style="color: [+ ddp_colour +];">**DDP**</span> ?]


[? if center_prescan: <span style="color: [+ z_colour +];">**[+ center_prescan +]**</span> ?]

[? if center_prescan: - <span style="color: [+ z_colour +];">**Z**</span> ?]


[? if kpd_prescan: <span style="color: [+ kpd_colour +];">**[+ kpd_prescan +]**</span> ?]

[? if kpd_prescan: - <span style="color: [+ kpd_colour +];">**KPD**</span> ?]


[? if not ddp_prescan == "Simons": <span style="color: [+ ddp_colour +];">**[+ ddp_prescan +]**</span> ?]

[? if ddp_prescan: - <span style="color: [+ ddp_colour +];">**DDP**</span> ?]


[? if bvp_prescan: <span style="color: [+ bvp_colour +];">**[+ bvp_prescan +]**</span> ?]

[? if bvp_prescan: - <span style="color: [+ bvp_colour +];">**BVP**</span> ?]

[? if bvp_prescan: - <span style="color: #63C489;">**DHP**</span> ?]

[? if bvp_prescan: - <span style="color: #38C538;">**[+ dbp_name +]**</span> ?]


[? if nsdap_prescan: <span style="color: [+ nsdap_colour +];">**[+ nsdap_prescan +]**</span> ?]

[? if nsdap_prescan: - <span style="color: [+ nsdap_colour +];">**NSDAP**</span> ?]

(and maybe more, idk)

- @minor_left_support: Who do the other worker's parties support?


@minor_left_support
on-arrival: {!

if (Q.uspd_leader == "Ledebour" && !Q.proletarian_prescan) Q.uspd_prs_support = "KPD";
if (Q.uspd_leader == "Liebknecht" && !Q.proletarian_prescan) Q.uspd_prs_support = "none";
if (Q.uspd_leader == "Breitscheid" && !Q.proletarian_prescan && Q.spd_prescan) Q.uspd_prs_support = "SPD";
if (Q.uspd_leader == "Crispien" && !Q.proletarian_prescan && Q.spd_prescan) Q.uspd_prs_support = "SPD";
if (Q.uspd_leader == "Breitscheid" && !Q.proletarian_prescan && !Q.spd_prescan) Q.uspd_prs_support = "none";
if (Q.uspd_leader == "Crispien" && !Q.proletarian_prescan && !Q.spd_prescan) Q.uspd_prs_support = "none";
if (Q.proletarian_prescan) Q.uspd_prs_support = "unity";
if (Q.sb_exists && Q.proletarian_prescan) Q.sb_support = "unity";
if (Q.sb_exists && !Q.proletarian_prescan) Q.sb_support = "KPD";

!}

[? if national_right_spd and (spd_prescan == "Braun" or spd_prescan == "Scheidemann"): <span style="color: [+ aspd_colour +];">**[+ aspd_name +]**</span>: <span style="color: [+ spd_colour +];">**[+ spd_prescan +]**</span> ?]

[? if national_right_spd and not (spd_prescan == "Braun" or spd_prescan == "Scheidemann"): <span style="color: [+ aspd_colour +];">**[+ aspd_name +]**</span>: <span style="color: [+ ddp_colour +];">**[+ ddp_prescan +]**</span> ?]

[? if uspd_leader == "Ledebour" and not proletarian_prescan: <span style="color: [+ uspd_colour +];">**USPD**</span>: <span style="color: [+ kpd_colour +];">**[+ kpd_prescan +]**</span> ?]

[? if uspd_leader == "Liebknecht" and not proletarian_prescan: <span style="color: [+ uspd_colour +];">**USPD**</span>: abstain ?]

[? if (uspd_leader == "Breitscheid" or uspd_leader == "Crispien") and not proletarian_prescan and spd_prescan: <span style="color: [+ uspd_colour +];">**USPD**</span>: <span style="color: [+ spd_colour +];">**[+ spd_prescan +]**</span> ?][? if (uspd_leader == "Breitscheid" or uspd_leader == "Crispien") and not proletarian_prescan and not spd_prescan: <span style="color: [+ uspd_colour +];">**USPD**</span>: unclear ?]

[? if proletarian_prescan and ledebour_unity_candidate: <span style="color: [+ uspd_colour +];">**USPD**</span>: <span style="color: [+ ledebour_colour +];">**Georg Ledebour**</span> ?]

[? if proletarian_prescan and rosenfeld_unity_candidate: <span style="color: [+ uspd_colour +];">**USPD**</span>: <span style="color: [+ rosenfeld_colour +];">**Kurt Rosenfeld**</span> ?]

[? if sb_exists and ledebour_unity_candidate: <span style="color: [+ sb_colour +];">**SB**</span>: <span style="color: [+ ledebour_colour +];">**Georg Ledebour**</span> ?]

[? if sb_exists and rosenfeld_unity_candidate: <span style="color: [+ sb_colour +];">**SB**</span>: <span style="color: [+ rosenfeld_colour +];">**Kurt Rosenfeld**</span> ?]

[? if sb_exists and not proletarian_prescan: <span style="color: [+ sb_colour +];">**SB**</span>: <span style="color: [+ kpd_colour +];">**[+ kpd_prescan +]**</span> ?]

<span style="color: #3A0000;">**KAPD**</span>: abstain



- @support_other_candidate
- @conclude_candidacies



@support_other_candidate
title: Who are we going to back?
view-if: no_spd_participation == 1


- @centrist: Let's hope <span style="color: [+ z_colour +];">**[+ center_prescan +]**</span> won't forget our help.
- @the_ddp: Let's hope <span style="color: [+ ddp_colour +];">**[+ ddp_prescan +]**</span> won't forget our help.
- @them_communists: Let's hope <span style="color: [+ kpd_colour +];">**[+ kpd_prescan +]**</span> won't forget our help.
- @noone: We won't endorse anyone...


@centrist
go-to: conclude_candidacies
on-arrival: spd_supports_center = 1

@the_ddp
go-to: conclude_candidacies
on-arrival: spd_supports_ddp = 1

@them_communists
go-to: conclude_candidacies
on-arrival: spd_supports_kpd = 1

@noone
go-to: conclude_candidacies
on-arrival: spd_supports_nobody = 1



@conclude_candidacies
title: Scout out potential endorsments
view-if: no_spd_participation == 0


- @uspd_endorsement: Get the <span style="color: [+ uspd_colour +];">**USPD**</span> to support us
- @aspd_endorsment: Get the <span style="color: [+ aspd_colour +];">**[+ aspd_name +]**</span> to support us

@uspd_endorsement
view-if: uspd_joined < 3 and uspd_prs_support == "none"
choose-if: (uspd_relation >= 70 and uspd_leader == "Liebknecht" and left_strength > reformist_strength) or (not uspd_leader == "Liebknecht" and uspd_relation >= 55)
on-arrival: uspd_spd_joint_campaign = 1
unavailable-subtitle: The <span style="color: [+ uspd_colour +];">**USPD**</span> does not consider this. They will most likely abstain.
go-to: conclude_candidacies

@aspd_endorsment
view-if: national_right_spd
go-to: conclude_candidacies
choose-if: spd_supports_center or spd_supports_ddp or spd_support_simons or spd_prescan == "Braun" or spd_prescan == "Scheidemann"
on-arrival: aspd_spd_joint_campaign = 1
unavailable-subtitle: The <span style="color: [+ aspd_colour +];">**[+ aspd_name +]**</span> would prefer to support a bourgeois candidate.








