    <circle
       style="fill:#1b0000;fill-opacity:1;stroke:#000000;stroke-width:1.947;stroke-linejoin:miter;stroke-miterlimit:4;stroke-dasharray:none;stroke-opacity:1;paint-order:normal"
       id="path29-8-6"
       cx="[+ soc_kapd +]"
       cy="[+ rep_kapd +]"
       inkscape:label="compass_party_kapd"
       r="7">
      <title
