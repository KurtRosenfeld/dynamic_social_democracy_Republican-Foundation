title: Wanna play the lottery?
subtitle: This is only some test that does nothing real yet
view-if: year == 1922 and month == 4
max-visits: 1
priority: 8
tags: event
new-page: true
on-arrival: {!
  const WEIGHTS = {
    fleissner:   0.10,
    zeigner:     0.10,
    woytinsky:   0.10,
    baade:       0.10,
    heldt:       0.15,
    buck:        0.15,
    greszinski:  0.15,
    hirschfeld:  0.15
  };

  // You have to a member to be voted in
  const ELIGIBLE = {
    fleissner:   Q.fleissner_in   === "SPD",
    zeigner:     Q.zeigner_in    === "SPD",
    woytinsky:   Q.woytinsky_in   === "SPD",
    baade:       Q.baade_in     === "SPD",
    heldt:       Q.heldt_in === "SPD",
    buck:        true,
    greszinski:  Q.greszinski_in  === "SPD",
    hirschfeld:  true
  };

  if (!Q.lottery_chosen) Q.lottery_chosen = [];

  const pool = Object.keys(WEIGHTS).filter(id =>
    ELIGIBLE[id] && !Q.lottery_chosen.includes(id)
  );

  // Join the commitee
  function pickWeighted(items) {
    const total = items.reduce((s, id) => s + WEIGHTS[id], 0);
    let r = Math.random() * total;
    for (let i = 0; i < items.length; i++) {
      r -= WEIGHTS[items[i]];
      if (r <= 0) return items.splice(i, 1)[0];
    }
    return items.pop();
  }

  // The newcomers
  const rolls = [];
  for (let i = 0; i < 3 && pool.length > 0; i++) {
    rolls.push(pickWeighted(pool));
  }

  Q.roll1 = rolls[0] || null;
  Q.roll2 = rolls[1] || null;
  Q.roll3 = rolls[2] || null;
!}

= Lottery


[+ roll1 +]

[+ roll2 +]

[+ roll3 +]

- @pick_baade: Fritz Baade
- @pick_woytinsky
- @pick_hirschfeld




@pick_baade
is-card: true
card-image: img/portaits/BaadeFritz.jpg
on-arrival: {!
  Q.baade_picked = 1;
  Q.lottery_chosen.push('baade');
!}

