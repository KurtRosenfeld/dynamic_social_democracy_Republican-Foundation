title: 1924 French Legislative Elections
view-if: year == 1922 and month == 4
new-page: true
tags: event
on-arrival: french_assembly_seats = 601
priority: 4
on-display: {!  
    var cardEl = document.createElement('div');  
    cardEl.className = "face-figure2";  

    var image = new Image();  
    image.className = "face-img";  
    image.src = "img/france_flag.png";  

    cardEl.appendChild(image);  
    var contentDiv = document.querySelector("#page #mid_panel #content");
    contentDiv.appendChild(cardEl);
!}
max-visits: 1
set-bg: img/france_map.jpg

= Elections, [+ month : month +] [+ year +]

The French Third Republic are to hold their legislative elections now.

- @france: May our <span style="color: #ff0000;">socialist</span> comrades do their best...

@france
on-arrival: {!

Q.old_sfio_assembly_vote = 20.8;
Q.old_prrrs_assembly_vote = 17.2;
Q.old_i_rad_assembly_vote = 10.7;
Q.old_ad_assembly_vote = 18.1;
Q.old_fr_assembly_vote = 21.9;
Q.old_pcf_assembly_vote = 0;
Q.old_prs_assembly_vote = 5.2;
Q.old_pdp_assembly_vote = 0.0;
Q.old_cons_assembly_vote = 6.1;

Q.old_assembly_r_sfio = 14.5;
Q.old_assembly_r_prrrs = 14.0;
Q.old_assembly_r_i_rad = 15.2;
Q.old_assembly_r_ad = 17.5;
Q.old_assembly_r_fr = 29.9;
Q.old_assembly_r_pcf = 0;
Q.old_assembly_r_prs = 4.2;
Q.old_assembly_r_pdp = 0.0;
Q.old_assembly_r_cons = 4.7;

var france_adjustment_factors = {
    sfio: 1.0,
    rad: 1.0,
    ad: 1.0,
    fr: 1.0,
    pcf: 1.0,
    prs: 1.0,
    pdp: 1.0,
    pup: 1.0,
};

Q.sfio_assembly_vote = 20.1;
Q.prrrs_assembly_vote = 13.3;
Q.i_rad_assembly_vote = 3.3;
Q.ad_assembly_vote = 8.4;
Q.fr_assembly_vote = 32.2;
Q.pcf_assembly_vote = 9.8;
Q.prs_assembly_vote = 5.7;
Q.pdp_assembly_vote = 3.2;
Q.cons_assembly_vote = 4.2;

if (Q.unemployed < 10) {
    france_adjustment_factors.ad += 0.06;
    france_adjustment_factors.fr += 0.06;
    france_adjustment_factors.pdp += 0.06;
    france_adjustment_factors.rad += 0.06;
} else if (Q.unemployed < 18) {
    france_adjustment_factors.ad += 0.04;
    france_adjustment_factors.fr += 0.04;
    france_adjustment_factors.pdp += 0.04;
    france_adjustment_factors.rad += 0.04;
} else if (Q.unemployed < 25) {
    france_adjustment_factors.ad += 0.03;
    france_adjustment_factors.fr += 0.03;
    france_adjustment_factors.pdp += 0.03;
    france_adjustment_factors.rad += 0.03;
} else if (Q.unemployed < 32) {
    france_adjustment_factors.ad += 0.02;
    france_adjustment_factors.fr += 0.02;
    france_adjustment_factors.pdp += 0.02;
    france_adjustment_factors.rad += 0.02;
} else if (Q.unemployed < 40) {
    france_adjustment_factors.ad += 0.01;
    france_adjustment_factors.fr += 0.01;
    france_adjustment_factors.pdp += 0.01;
    france_adjustment_factors.rad += 0.01;
}

if (Q.economic_growth >= 6) {
    france_adjustment_factors.ad += 0.06;
    france_adjustment_factors.fr += 0.06;
    france_adjustment_factors.pdp += 0.06;
    france_adjustment_factors.rad += 0.06;
} else if (Q.economic_growth >= 4) {
    france_adjustment_factors.ad += 0.04;
    france_adjustment_factors.fr += 0.04;
    france_adjustment_factors.pdp += 0.04;
    france_adjustment_factors.rad += 0.04;
} else if (Q.economic_growth >= 2) {
    france_adjustment_factors.ad += 0.03;
    france_adjustment_factors.fr += 0.03;
    france_adjustment_factors.pdp += 0.03;
    france_adjustment_factors.rad += 0.03;
} else if (Q.economic_growth >= 0) {
    france_adjustment_factors.ad += 0.02;
    france_adjustment_factors.fr += 0.02;
    france_adjustment_factors.pdp += 0.02;
    france_adjustment_factors.rad += 0.02;
} else if (Q.economic_growth >= -2) {
    france_adjustment_factors.ad += 0.01;
    france_adjustment_factors.fr += 0.01;
    france_adjustment_factors.pdp += 0.01;
    france_adjustment_factors.rad += 0.01;
}

if (Q.france_relation >= 50 && Q.spd_in_government) {
    france_adjustment_factors.sfio += (Q.france_relation / 500);
    france_adjustment_factors.prs += (Q.france_relation / 1000);
    france_adjustment_factors.rad += (Q.france_relation / 1000);
    if (Q.kpd_relation >= 50) {
        france_adjustment_factors.pcf += (Q.kpd_relation / 400);
        france_adjustment_factors.pup += (Q.kpd_relation / 400);
    }
}

if (!Q.spd_in_government && Q.international_socialist_support) {
    france_adjustment_factors.sfio += (Q.international_socialist_support / 50);
    france_adjustment_factors.prs += (Q.international_socialist_support / 100);
    france_adjustment_factors.rad += (Q.international_socialist_support / 100);
    if (Q.kpd_relation >= 50) {
        france_adjustment_factors.pcf += (Q.kpd_relation / 400);
        france_adjustment_factors.pup += (Q.kpd_relation / 400);
    }
}

if (Q.pacifism >= 3 && Q.spd_in_government) {
    france_adjustment_factors.sfio += (Q.pacifism / 50);
    france_adjustment_factors.prs += (Q.pacifism / 100);
    france_adjustment_factors.rad += (Q.pacifism / 100);
    if (Q.kpd_relation >= 50) {
        france_adjustment_factors.pcf += (Q.kpd_relation / 400);
        france_adjustment_factors.pup += (Q.kpd_relation / 400);
    }
}

Q.sfio_assembly_vote = Q.sfio_assembly_vote*france_adjustment_factors.sfio;
Q.ad_assembly_vote = Q.ad_assembly_vote*france_adjustment_factors.ad;
Q.fr_assembly_vote = Q.fr_assembly_vote*france_adjustment_factors.fr;
Q.pcf_assembly_vote = Q.pcf_assembly_vote*france_adjustment_factors.pcf;
Q.prs_assembly_vote = Q.prs_assembly_vote*france_adjustment_factors.prs;
Q.pdp_assembly_vote = Q.pdp_assembly_vote*france_adjustment_factors.pdp;
Q.prrrs_assembly_vote = Q.prrrs_assembly_vote*france_adjustment_factors.prrrs;
Q.i_rad_assembly_vote = Q.i_rad_assembly_vote*france_adjustment_factors.i_rad;
Q.cons_assembly_vote = Q.cons_assembly_vote*france_adjustment_factors.cons;

Q.total_votes_france = Q.sfio_assembly_vote + Q.ad_assembly_vote + Q.fr_assembly_vote + Q.pcf_assembly_vote + Q.prs_assembly_vote + Q.pdp_assembly_vote + Q.prrrs_assembly_vote + Q.i_rad_assembly_vote + Q.cons_assembly_vote;

if (Q.total_votes_france > 0) {
    Q.sfio_assembly_vote = (Q.sfio_assembly_vote / Q.total_votes_france) * 100;
    Q.ad_assembly_vote = (Q.ad_assembly_vote / Q.total_votes_france) * 100;
    Q.fr_assembly_vote = (Q.fr_assembly_vote / Q.total_votes_france) * 100;
    Q.pcf_assembly_vote = (Q.pcf_assembly_vote / Q.total_votes_france) * 100;
    Q.prs_assembly_vote = (Q.prs_assembly_vote / Q.total_votes_france) * 100;
    Q.pdp_assembly_vote = (Q.pdp_assembly_vote / Q.total_votes_france) * 100;
    Q.prrrs_assembly_vote = (Q.prrrs_assembly_vote / Q.total_votes_france) * 100;
    Q.i_rad_assembly_vote = (Q.i_rad_assembly_vote / Q.total_votes_france) * 100;
    Q.cons_assembly_vote = (Q.cons_assembly_vote / Q.total_votes_france) * 100;
}

Q.sfio_assembly_vote = (Q.sfio_assembly_vote != undefined ? parseFloat(Q.sfio_assembly_vote.toFixed(1)) : 0);
Q.ad_assembly_vote = (Q.ad_assembly_vote != undefined ? parseFloat(Q.ad_assembly_vote.toFixed(1)) : 0);
Q.fr_assembly_vote = (Q.fr_assembly_vote != undefined ? parseFloat(Q.fr_assembly_vote.toFixed(1)) : 0);
Q.pcf_assembly_vote = (Q.pcf_assembly_vote != undefined ? parseFloat(Q.pcf_assembly_vote.toFixed(1)) : 0);
Q.prs_assembly_vote = (Q.prs_assembly_vote != undefined ? parseFloat(Q.prs_assembly_vote.toFixed(1)) : 0);
Q.pdp_assembly_vote = (Q.pdp_assembly_vote != undefined ? parseFloat(Q.pdp_assembly_vote.toFixed(1)) : 0);
Q.prrrs_assembly_vote = (Q.prrrs_assembly_vote != undefined ? parseFloat(Q.prrrs_assembly_vote.toFixed(1)) : 0);
Q.i_rad_assembly_vote = (Q.i_rad_assembly_vote != undefined ? parseFloat(Q.i_rad_assembly_vote.toFixed(1)) : 0);
Q.cons_assembly_vote = (Q.cons_assembly_vote != undefined ? parseFloat(Q.cons_assembly_vote.toFixed(1)) : 0);

Q.sfio_assembly_r = (Q.sfio_assembly_vote - 2.8);
Q.prrrs_assembly_r = (Q.prrrs_assembly_vote + 6.7);
Q.i_rad_assembly_r = (Q.i_rad_assembly_vote + 0.4);
Q.ad_assembly_r = (Q.ad_assembly_vote -= 1.1);
Q.fr_assembly_r = (Q.fr_assembly_vote + 1.8);
Q.pcf_assembly_r = (Q.pcf_assembly_vote -= 5.5);
Q.prs_assembly_r = (Q.prs_assembly_vote += 1.5);
Q.pdp_assembly_r = (Q.pdp_assembly_vote += 0.1);
Q.cons_assembly_r = (Q.cons_assembly_vote);

Q.total_r_france = 0;

if (Q.sfio_assembly_r) Q.total_r_france += Q.sfio_assembly_r;
if (Q.prrrs_assembly_r) Q.total_r_france += Q.prrrs_assembly_r;
if (Q.i_rad_assembly_r) Q.total_r_france += Q.i_rad_assembly_r;
if (Q.ad_assembly_r) Q.total_r_france += Q.ad_assembly_r;
if (Q.fr_assembly_r) Q.total_r_france += Q.fr_assembly_r;
if (Q.pcf_assembly_r) Q.total_r_france += Q.pcf_assembly_r;
if (Q.prs_assembly_r) Q.total_r_france += Q.prs_assembly_r;
if (Q.pdp_assembly_r) Q.total_r_france += Q.pdp_assembly_r;
if (Q.cons_assembly_r) Q.total_r_france += Q.cons_assembly_r;

if (Q.total_r_france > 0) {
    Q.sfio_assembly_r = (Q.sfio_assembly_r / Q.total_r_france) * 100;
    Q.ad_assembly_r = (Q.ad_assembly_r / Q.total_r_france) * 100;
    Q.fr_assembly_r = (Q.fr_assembly_r / Q.total_r_france) * 100;
    Q.pcf_assembly_r = (Q.pcf_assembly_r / Q.total_r_france) * 100;
    Q.prs_assembly_r = (Q.prs_assembly_r / Q.total_r_france) * 100;
    Q.pdp_assembly_r = (Q.pdp_assembly_r / Q.total_r_france) * 100;
    Q.prrrs_assembly_r = (Q.prrrs_assembly_r / Q.total_r_france) * 100;
    Q.i_rad_assembly_r = (Q.i_rad_assembly_r / Q.total_r_france) * 100;
    Q.cons_assembly_r = (Q.cons_assembly_r / Q.total_r_france) * 100;
}

Q.sfio_assembly_r = (Q.sfio_assembly_r != undefined ? parseFloat(Q.sfio_assembly_r.toFixed(1)) : 0);
Q.ad_assembly_r = (Q.ad_assembly_r != undefined ? parseFloat(Q.ad_assembly_r.toFixed(1)) : 0);
Q.fr_assembly_r = (Q.fr_assembly_r != undefined ? parseFloat(Q.fr_assembly_r.toFixed(1)) : 0);
Q.pcf_assembly_r = (Q.pcf_assembly_r != undefined ? parseFloat(Q.pcf_assembly_r.toFixed(1)) : 0);
Q.prs_assembly_r = (Q.prs_assembly_r != undefined ? parseFloat(Q.prs_assembly_r.toFixed(1)) : 0);
Q.pdp_assembly_r = (Q.pdp_assembly_r != undefined ? parseFloat(Q.pdp_assembly_r.toFixed(1)) : 0);
Q.prrrs_assembly_r = (Q.prrrs_assembly_r != undefined ? parseFloat(Q.prrrs_assembly_r.toFixed(1)) : 0);
Q.i_rad_assembly_r = (Q.i_rad_assembly_r != undefined ? parseFloat(Q.i_rad_assembly_r.toFixed(1)) : 0);
Q.cons_assembly_r = (Q.cons_assembly_r != undefined ? parseFloat(Q.cons_assembly_r.toFixed(1)) : 0);


Q.left_cartel_coalition = parseFloat((Q.sfio_assembly_r + Q.prrrs_assembly_r + Q.prs_assembly_r + Q.i_rad_assembly_r).toFixed(1));
Q.millerand_coalition = parseFloat((Q.ad_r_france + Q.fr_r_france + Q.i_rad_r_france).toFixed(1));
Q.realistic_millerand_coalition = parseFloat((Q.ad_r_france + Q.fr_r_france).toFixed(1));

Q.french_parties = ['sfio', 'pcf', 'cons', 'prs', 'prrrs', 'i_rad', 'pdp', 'ad', 'fr'];

for (var party of Q.french_parties) {
    Q['change_' + party + '_assembly_r'] = Q[party + '_assembly_r'] - Q['old_' + party + '_assembly_r'];
    var sign = Q['change_' + party + '_assembly_r'] > 0 
               ? '<img src="img/arrowup.png"> ' 
               : Q['change_' + party + '_assembly_r'] < 0 
                 ? '<img src="img/arrowdown.png"> ' 
                 : '<img src="img/steady.png"> ';
    Q['change_' + party + '_assembly_r'] = Math.abs(Q['change_' + party + '_assembly_r']);
    Q['str_change_' + party + '_france'] = sign + parseFloat(Q['change_' + party + '_assembly_r']).toFixed(1);

    // Calculate changes in votes
    Q['change_' + party + '_votes_france'] = Q[party + '_assembly_vote'] - Q['old_' + party + '_assembly_vote'];
    if (Q['old_' + party + '_assembly_vote'] === undefined) {
        Q['change_' + party + '_votes_france'] = Q[party + '_assembly_vote'];
    }

    var sign2 = Q['change_' + party + '_votes_france'] > 0 
                ? '<img src="img/arrowup.png"> ' 
                : Q['change_' + party + '_votes_france'] < 0 
                  ? '<img src="img/arrowdown.png"> ' 
                  : '<img src="img/steady.png"> ';
    Q['str_votes_change_' + party + '_france'] = sign2 + Math.abs(Q['change_' + party + '_votes_france']).toFixed(1);
}


Q.sfio_assembly_vote = (Q.sfio_assembly_vote != undefined ? parseFloat(Q.sfio_assembly_vote.toFixed(1)) : 0);
Q.ad_assembly_vote = (Q.ad_assembly_vote != undefined ? parseFloat(Q.ad_assembly_vote.toFixed(1)) : 0);
Q.fr_assembly_vote = (Q.fr_assembly_vote != undefined ? parseFloat(Q.fr_assembly_vote.toFixed(1)) : 0);
Q.pcf_assembly_vote = (Q.pcf_assembly_vote != undefined ? parseFloat(Q.pcf_assembly_vote.toFixed(1)) : 0);
Q.prs_assembly_vote = (Q.prs_assembly_vote != undefined ? parseFloat(Q.prs_assembly_vote.toFixed(1)) : 0);
Q.pdp_assembly_vote = (Q.pdp_assembly_vote != undefined ? parseFloat(Q.pdp_assembly_vote.toFixed(1)) : 0);
Q.prrrs_assembly_vote = (Q.prrrs_assembly_vote != undefined ? parseFloat(Q.prrrs_assembly_vote.toFixed(1)) : 0);
Q.i_rad_assembly_vote = (Q.i_rad_assembly_vote != undefined ? parseFloat(Q.i_rad_assembly_vote.toFixed(1)) : 0);
Q.cons_assembly_vote = (Q.cons_assembly_vote != undefined ? parseFloat(Q.cons_assembly_vote.toFixed(1)) : 0);

Q.sfio_assembly_r = (Q.sfio_assembly_r != undefined ? parseFloat(Q.sfio_assembly_r.toFixed(1)) : 0);
Q.ad_assembly_r = (Q.ad_assembly_r != undefined ? parseFloat(Q.ad_assembly_r.toFixed(1)) : 0);
Q.fr_assembly_r = (Q.fr_assembly_r != undefined ? parseFloat(Q.fr_assembly_r.toFixed(1)) : 0);
Q.pcf_assembly_r = (Q.pcf_assembly_r != undefined ? parseFloat(Q.pcf_assembly_r.toFixed(1)) : 0);
Q.prs_assembly_r = (Q.prs_assembly_r != undefined ? parseFloat(Q.prs_assembly_r.toFixed(1)) : 0);
Q.pdp_assembly_r = (Q.pdp_assembly_r != undefined ? parseFloat(Q.pdp_assembly_r.toFixed(1)) : 0);
Q.prrrs_assembly_r = (Q.prrrs_assembly_r != undefined ? parseFloat(Q.prrrs_assembly_r.toFixed(1)) : 0);
Q.i_rad_assembly_r = (Q.i_rad_assembly_r != undefined ? parseFloat(Q.i_rad_assembly_r.toFixed(1)) : 0);
Q.cons_assembly_r = (Q.cons_assembly_r != undefined ? parseFloat(Q.cons_assembly_r.toFixed(1)) : 0);


!}
on-display: {!
data = [{
    "id": "pcf",
    "legend": "PCF",
    "name": "PCF",
    "seats": Math.round(Q.pcf_assembly_r * 6.01),
}];


data = data.concat([{
    "id": "sfio",
    "legend": "SFIO",
    "name": "SFIO",
    "seats": Math.round(Q.sfio_assembly_r * 6.01),
}]);

if (Q.prs_assembly_r) {
    data.push({
        "id": "prs",
        "legend": "PRS",
        "name": "PRS",
        "seats": Math.round(Q.prs_assembly_r * 6.01),
    });
}

if (Q.prrrs_assembly_r) {
    data.push({
        "id": "rad",
        "legend": "RAD",
        "name": "RAD",
        "seats": Math.round(Q.prrrs_assembly_r * 6.01),
    });
}
             
if (Q.i_rad_assembly_r) {
    data.push({
        "id": "rad2",
        "legend": "RAD2",
        "name": "RAD2",
        "seats": Math.round(Q.i_rad_assembly_r * 6.01),
    });
}

if (Q.ad_assembly_r) {
    data.push({
        "id": "ad",
        "legend": "AD",
        "name": "AD",
        "seats": Math.round(Q.ad_assembly_r * 6.01),
    });
}

if (Q.pdp_assembly_r) {
    data.push({
        "id": "pdp",
        "legend": "PDP",
        "name": "PDP",
        "seats": Math.round(Q.pdp_assembly_r * 6.01),
    });
}

if (Q.fr_assembly_r) {
    data.push({
        "id": "fr",
        "legend": "FR",
        "name": "FR",
        "seats": Math.round(Q.fr_assembly_r * 6.01),
    });
}
  
if (Q.cons_assembly_r) {
    data.push({
        "id": "fr2",
        "legend": "FR2",
        "name": "FR2",
        "seats": Math.round(Q.cons_assembly_r * 6.01),
    });
}

if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("france_chamber").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#france_chamber").datum(data).call(parliament);
}
!}
