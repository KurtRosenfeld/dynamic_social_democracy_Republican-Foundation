       style="fill:[+ uspd_colour +];fill-opacity:1;stroke:#000000;stroke-width:1.947;stroke-linejoin:miter;stroke-miterlimit:4;stroke-dasharray:none;stroke-opacity:1;paint-order:normal"
       id="path29-86"
       cx="[+ soc_uspd +]"
       cy="[+ rep_uspd +]"
       inkscape:label="compass_party_uspd"
       r="7">
      <title
         id="title39">USPD</title>
    </circle> ?]
[? if sb_exists:    <circle
       style="fill:[+ sb_colour +];fill-opacity:1;stroke:#000000;stroke-width:1.947;stroke-linejoin:miter;stroke-miterlimit:4;stroke-dasharray:none;stroke-opacity:1;paint-order:normal"
       id="path29-86-1"
       cx="[+ soc_sb +]"
       cy="[+ rep_sb +]"
       inkscape:label="compass_party_sb"
       r="7">
