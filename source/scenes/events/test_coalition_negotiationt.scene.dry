- @invite_ddp: Invite the **[+ ddp_name +]**
- @invite_z: Invite the **[+ z_party_name +]**
- @invite_dbp: Invite the **[+ dbp_name +]**
- @invite_dvp: Invite the DVP
- @beg_dvp: Beg the DVP






@invite_ddp
view-if: lvp_formed == 0
choose-if: ddp_coal_points > 60
on-arrival: national_ddp = 1; coalition_r = coalition_r += ddp_r
subtitle: [? if ddp_r >= 1: The **[+ ddp_name +]** will demand a ministry. ?]
go-to: return_to_coalopt
  
@invite_z
choose-if: z_coal_points > 70
on-arrival: national_z = 1; coalition_r = coalition_r += z_r
subtitle: [? if z_r >= 1: The **[+ z_party_name +]** will demand a ministry. ?]
go-to: return_to_coalopt

@invite_dbp
choose-if: dbp_coal_points > 60
on-arrival: national_dbp = 1; coalition_r = coalition_r += dbp_r
subtitle: [? if dbp_r >= 1: The **[+ dbp_name +]** will demand a ministry. ?]
go-to: return_to_coalopt

@invite_dvp
view-if: lvp_formed == 0
choose-if: dvp_coal_points > 100
on-arrival: national_dvp = 1; coalition_r = coalition_r += dvp_r
subtitle: [? if dvp_r >= 1: The **DVP** will demand a ministry. ?]
go-to: return_to_coalopt

@beg_dvp
view-if: dvp_coal_points <= 100 and dvp_coal_points >= 85
choose-if: dvp_coal_points > 90
on-arrival: national_dvp = 1; coalition_r = coalition_r += dvp_r
subtitle: This will give additional leverage to the DVP
unavailable-subtitle: No chance.
go-to: return_to_coalopt




















  
