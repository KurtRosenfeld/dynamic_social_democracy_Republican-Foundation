[? if not lvp_formed and dvp_exist and not dvp_dnef:  <circle
       style="fill:[+ dvp_colour +];fill-opacity:1;stroke:#000000;stroke-width:1.947;stroke-linejoin:miter;stroke-miterlimit:4;stroke-dasharray:none;stroke-opacity:1;paint-order:normal"
