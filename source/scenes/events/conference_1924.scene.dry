title: SPD Party Conference of Berlin
view-if: year == 1924 and month == 6
max-visits: 1
tags: event
new-page: true
on-arrival: {!

Q.parteitag_seats = 390; 

Q.neorev_spd_r = 0.5; Q.socpat_strength = 1; Q.socpat_spd_r = 0.5;

Q.left_pas = 0;
Q.center_pas = 0;
Q.labor_pas = 0;
Q.reformist_pas = 0;
Q.neorev_pas = 0;
Q.socpat_pas = 0;
Q.other_pas = 0;
Q.non_inscrit_pas = 0;


Q.left_pas = (Q.left_strength + Q.left_spd_r)*((100-Q.left_dissent)/100);
Q.center_pas = (Q.center_strength + Q.center_spd_r)*((100-Q.center_dissent)/100);
Q.labor_pas = (Q.labor_strength + Q.labor_spd_r)*((100-Q.labor_dissent)/100);
Q.reformist_pas = (Q.reformist_strength + Q.reformist_spd_r)*((100-Q.reformist_dissent)/100);
Q.neorev_pas = (Q.neorev_strength + Q.neorev_spd_r)*((100-Q.neorev_dissent)/100);
Q.socpat_pas = (Q.socpat_strength + Q.socpat_spd_r)*((100-Q.socpat_dissent)/100);

Q.other_pas = 2;
if (Q.neorevisionism == 0) Q.other_pas += Q.neorev_pas + 1;
if (Q.social_patriot == 0) Q.other_pas += Q.socpat_pas + 1;

Q.non_inscrit_pas = 4;
if (Q.left_pas < 5) Q.non_inscrit_pas += 1;
if (Q.labor_pas < 6) Q.non_inscrit_pas += 3;
if (Q.center_pas < 10) Q.non_inscrit_pas += 1.5;
if (Q.reformist_pas < 8) Q.non_inscrit_pas += 1;
if (Q.left_split) Q.non_inscrit_pas += 0.5;
if (Q.centrists_resign) Q.non_inscrit_pas += 0.5;
if (Q.unions_independent ) Q.non_inscrit_pas += 0.5;
if (Q.reformists_resigned ) Q.non_inscrit_pas += 0.5;

Q.left_pas_r = Q.left_pas;
Q.center_pas_r = Q.center_pas;
Q.labor_pas_r = Q.labor_pas;
Q.reformist_pas_r = Q.reformist_pas;
Q.neorev_pas_r = Q.neorev_pas;
Q.socpat_pas_r = Q.socpat_pas;
Q.other_pas_r = Q.other_pas;
Q.non_inscrit_pas_r = Q.non_inscrit_pas;

Q.anti_ebert_r = Q.left_pas + Q.labor_pas*0.05;
Q.pro_ebert_r = 100 - Q.anti_ebert_r

function allocateSeats(percentages, totalSeats = 390) {
    const exactSeats = {};
    const flooredSeats = {};
    const remainders = [];

    let totalFlooredSeats = 0;
    for (const party in percentages) {
        const exact = (percentages[party] * totalSeats) / 100;
        const floored = Math.floor(exact);
        const remainder = exact - floored;

        exactSeats[party] = exact;
        flooredSeats[party] = floored;
        totalFlooredSeats += floored;

        remainders.push({ party, remainder });
    }

    const seatsToDistribute = totalSeats - totalFlooredSeats;
    remainders.sort((a, b) => b.remainder - a.remainder);

    for (let i = 0; i < seatsToDistribute; i++) {
        flooredSeats[remainders[i].party]++;
    }

    return flooredSeats;
}

const inputPercentages = {
    left_pas_r: Q.left_pas_r,
    center_pas_r: Q.center_pas_r,
    labor_pas_r: Q.labor_pas_r,
    reformist_pas_r: Q.reformist_pas_r,
    neorev_pas_r: Q.neorev_pas_r,
    socpat_pas_r: Q.socpat_pas_r,
    other_pas_r: Q.other_pas_r,
    non_inscrit_pas_r: Q.non_inscrit_pas_r
};

const allocatedSeats = allocateSeats(inputPercentages);

for (const party in allocatedSeats) {
    Q[party] = parseFloat(((allocatedSeats[party] * 100) / 390).toFixed(1));
}

!}
on-display: {!
// Calculate seats using your allocation function
const inputPercentages = {
    left_pas_r: Q.left_pas_r,
    center_pas_r: Q.center_pas_r,
    labor_pas_r: Q.labor_pas_r,
    reformist_pas_r: Q.reformist_pas_r,
    neorev_pas_r: Q.neorev_pas_r,
    socpat_pas_r: Q.socpat_pas_r,
    other_pas_r: Q.other_pas_r,
    non_inscrit_pas_r: Q.non_inscrit_pas_r
};

// Build the data array directly
var data = [];

if (Q.left_pas_r > 0) {
    data.push({
        "id": "left_pas",
        "legend": "Left",
        "name": "Left",
        "seats": Math.round(Q.left_pas_r * 3.9)
    });
}

if (Q.center_pas_r > 0) {
    data.push({
        "id": "center_pas",
        "legend": "Center",
        "name": "Center",
        "seats": Math.round(Q.center_pas_r * 3.9)
    });
}

if (Q.non_inscrit_pas_r > 0) {
    data.push({
        "id": "non_inscrit_pas",
        "legend": "NI",
        "name": "NI",
        "seats": Math.round(Q.non_inscrit_pas_r * 3.9)
    });
}

if (Q.labor_pas_r > 0) {
    data.push({
        "id": "labor_pas",
        "legend": "Labor",
        "name": "Labor",
        "seats": Math.round(Q.labor_pas_r * 3.9)
    });
}

if (Q.reformist_pas_r > 0) {
    data.push({
        "id": "reformist_pas",
        "legend": "Reformist",
        "name": "Reformist",
        "seats": Math.round(Q.reformist_pas_r * 3.9)
    });
}

if (Q.other_pas_r > 0) {
    data.push({
        "id": "other_pas",
        "legend": "Other",
        "name": "Other",
        "seats": Math.round(Q.other_pas_r * 3.9)
    });
}

if (Q.neorev_pas_r > 0) {
    data.push({
        "id": "neorev_pas",
        "legend": "Neorevison",
        "name": "Neo",
        "seats": Math.round(Q.neorev_pas_r * 3.9)
    });
}

if (Q.socpat_pas_r > 0) {
    data.push({
        "id": "socpat_pas",
        "legend": "Patriot",
        "name": "Patriot",
        "seats": Math.round(Q.socpat_pas_r * 3.9)
    });
}

// Render the parliament chart
if (window && d3 && data.length > 0) {
    // Clear previous chart
    var container = document.getElementById('berlin_parteitag');
    if (container) {
        while (container.firstChild) {
            container.removeChild(container.firstChild);
        }
        
        var width = 500;
        var height = 250;
        var screenWidth = document.getElementById('content').offsetWidth;
        if (screenWidth < width - 50) {
            width = screenWidth - 50;
            height = width / 2;
        }
        
        var svg = d3.select(container)
            .append('svg')
            .attr('width', width)
            .attr('height', height);
        
        var parliament = d3.parliament();
        parliament.width(width).height(height).innerRadiusCoef(0.4);
        parliament.enter.fromCenter(true).smallToBig(true);
        parliament.exit.toCenter(false).bigToSmall(true);
        
        svg.datum(data).call(parliament);
    }
}
!}

= SPD Party Congress

<svg id="berlin_parteitag" style="width: 500px; height: 250px;"> </svg>


- @berlin_menu

@berlin_menu
title: What is on the agenda?

- @coalition_questions: Our stance to coalitions
- @expelling_ebert_from_the_party: Expelling Ebert from the party
- @reichswehr_etat: The Reichswehr Etat
- @iah_and_membership: SPD members in the International Worker's Relief
- @paramilitary: The <span style="color: [+ rb_colour +];">**[+ reichsbanner_name +]**</span>
- @rural_electoral_strategy: Rural electoral strategy
- @party_leader_election: Party leader election
- @free_advisor: We are done


@expelling_ebert_from_the_party
subtitle: A group in Frankfurt has demanded the expulsion of Ebert from the SPD.
view-if: ebert_in == "SPD" and berlin_point_two == 0

- @hold_ebert: Ebert will remain in the party
- @fuck_that_stupid_bitch: Ebert will be expelled


@hold_ebert
subtitle: ([+ pro_ebert_r +]%)
choose-if: pro_ebert_r >= 50
on-arrival: left_strength -= 2; left_dissent += 1; berlin_point_two += 1
go-to: berlin_menu

Ebert will remain.

@fuck_that_stupid_bitch
subtitle: ([+ anti_ebert_r +]%)
choose-if: anti_ebert_r > 50
on-arrival: ebert_in = "I"; reformist_dissent += 10; reformist_strength -= 1; left_dissent -= 4; berlin_point_two += 1
go-to: berlin_menu

Ebert will be kicked out.


@coalition_questions
view-if: berlin_point_one == 0


- @maximalism: We will defend the interests of the proletariat without compromise. The only acceptable coalition type is cooperation among worker's parties.
- @centrism: We have to participate in parliament to protect the working class from the worst excesses of capitalism while preparing for a Social-Democratic majority.
- @reformism: The democratic parliament is our greatest achievement, we need to form coalitions with the bourgeois parties to strengthen our appeal to multiple demographics and fulfill our programme


@maximalism
choose-if: (left_pas_r + non_inscrit_pas) > 35 or labor_pas_r > 33
on-arrival: left_strength += 5; unemployed_spd += 2; left_dissent -= 3; reformist_dissent += 3; berlin_point_one += 1
go-to: berlin_menu


@centrism
choose-if: (center_pas_r + non_inscrit_pas) > 35 or labor_pas_r > 33
on-arrival: center_strength += 5; left_dissent -= 2; reformist_dissent -= 2; berlin_point_one += 1
go-to: berlin_menu


@reformism
choose-if: reformist_pas_r > 35 or labor_pas_r > 33
on-arrival: reformist_strength += 5; new_middle_spd += 2; left_dissent += 3; reformist_dissent -= 3; berlin_point_one += 1
go-to: berlin_menu


@reichswehr_etat
view-if: berlin_point_three == 0

- @childrens_meals: We should not finance the reaction, tax money should be spent on the needs of the poor.
- @noooooooooske: We need to maintain the armed forces to prevent the from revolting and eventually turn them into a republican army.


@childrens_meals
on-arrival: z_relation -= 3; dvp_relation -= 3; uspd_relation += 2; sb_relation += 2; berlin_point_three += 1
go-to: berlin_menu


@noooooooooske
on-arrival: left_dissent += 3; labor_dissent += 2; uspd_relation -= 2; berlin_point_three += 1
go-to: berlin_menu


@iah_and_membership
view-if: berlin_point_four == 0

The Worker's International Relief is a communist organisation.

Should SPD members be allowed to join?

- @yes_iah: It is their right
- @noo_iah: This is not possible


@yes_iah
on-arrival: sb_relation += 3; kpd_relation += 1; berlin_point_four += 1
go-to: berlin_menu


@noo_iah
on-arrival: soviet_relation -= 2; kpd_relation -= 1; berlin_point_four += 1
go-to: berlin_menu


@paramilitary
view-if: rb_exists and berlin_point_five == 0

- @rb_founding: We should increase founding for the <span style="color: [+ rb_colour +];">**[+ reichsbanner_name +]**</span>.
- @no_rb_found: We should not put resources into the <span style="color: [+ rb_colour +];">**[+ reichsbanner_name +]**</span>.


@rb_founding
choose-if: (kpd_reichsbanner and (left_pas_r + non_inscrit_pas_r >= 50)) or ((center_pas_r + non_inscrit_pas_r >= 50) and z_reichsbanner) or reichsbanner_orientation == "SPD"
on-arrival: rb_funding_cealing += 2; berlin_point_five += 1
unavailable-subtitle: There is no majority for this.
go-to: berlin_menu


@no_rb_found
on-arrival: reformist_dissent -= 3; berlin_point_five += 1
go-to: berlin_menu



@rural_electoral_strategy
view-if: berlin_point_six == 0

- @agrarian_programme: We should adopt an agricultural programme to give small farmers a reason to vote for us.
- @educate_rural_folk: We should combat Antisemitism in rural communties.
- @rural_class_war: We should agitate for class politics in the countryside.



@agrarian_programme
go-to: berlin_menu
choose-if: reformist_pas_r < 33
on-arrival: berlin_point_six += 1; rural_strategy = "Reformism"


@educate_rural_folk
go-to: berlin_menu
on-arrival: berlin_point_six += 1; rural_strategy = "Education"



@rural_class_war
go-to: berlin_menu
choose-if: left_pas_r > 43
on-arrival: berlin_point_six += 1; rural_strategy = "Class War"




@party_leader_election
view-if: berlin_point_seven == 0
on-arrival: berlin_point_seven += 1
go-to: berlin_menu

Placeholder lÖl


@free_advisor
view-if: berlin_point_six == 1
















































