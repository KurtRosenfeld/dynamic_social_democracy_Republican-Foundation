title: Anhalt Landtag Election
view-if: (year == 1924 and month == 6 and not anhalt_election_seen) or (anhalt_election_2_trigger_time == time and anhalt_election_seen_time != time)
new-page: true
tags: event
on-arrival: anhalt_election_seen += 1 if anhalt_election_seen; anhalt_election_seen = 1 if not anhalt_election_seen; anhalt_election_seen_time = time; anhalt_spd = 0; anhalt_kpd = 0; anhalt_sapd = 0; anhalt_uspd = 0; anhalt_ddp = 0; anhalt_kvp = 0; anhalt_true_others = 0; anhalt_wp = 0; anhalt_lvp = 0; anhalt_lr = 0; anhalt_z = 0; anhalt_dvp = 0; anhalt_dnvp = 0
priority: 2
on-display: {!
var cardEl = document.createElement('div');
cardEl.className = "face-figure2";

var image = new Image();
image.className = "face-img";
image.src = "img/states.png";

cardEl.appendChild(image);
var contentDiv = document.querySelector("#page #mid_panel #content");
contentDiv.appendChild(cardEl);
!}

= Elections, [+ month : month +] [+ year +]

The Anhalt state elections are to be held now.

- @anhalt: May we do our best...

@anhalt
on-arrival: {!

var anhalt_adjustment_factors = {
spd: 1.42,
sapd: 1.04,
uspd: 1.06,
kpd: 0.72,
ddp: 0.78,
lvp: 1.35,
z: 0.06,
dvp: 1.74,
dnvp: 0.65,
nsdap: 0.95,
dvfp: 1.0,
nsfb: 0.9,
other: 1.9,
kvp: 0.8,
dnf: 0.05
};

Q.spd_r_anhalt = 0;
Q.sapd_r_anhalt = 0;
Q.uspd_r_anhalt = 0;
Q.kpd_r_anhalt = 0;
Q.z_r_anhalt = 0;
Q.ddp_r_anhalt = 0;
Q.lvp_r_anhalt = 0;
Q.dvp_r_anhalt = 0;
Q.dnvp_r_anhalt = 0;
Q.nsdap_r_anhalt = 0;
Q.dvfp_r_anhalt = 0;
Q.nsfb_r_anhalt = 0;
Q.other_r_anhalt = 0;
Q.kvp_r_anhalt = 0;
Q.dnf_r_anhalt = 0;

Q.spd_anhalt_elections_vote = 0;
Q.sapd_anhalt_elections_vote = 0;
Q.uspd_anhalt_elections_vote = 0;
Q.kpd_anhalt_elections_vote = 0;
Q.ddp_anhalt_elections_vote = 0;
Q.lvp_anhalt_elections_vote = 0;
Q.z_anhalt_elections_vote = 0;
Q.dvp_anhalt_elections_vote = 0;
Q.dnvp_anhalt_elections_vote = 0;
Q.nsdap_anhalt_elections_vote = 0;
Q.dvfp_anhalt_elections_vote = 0;
Q.nsfb_anhalt_elections_vote = 0;
Q.other_anhalt_elections_vote = 0;
Q.kvp_anhalt_elections_vote = 0;
Q.dnf_anhalt_elections_vote = 0;

if (Q.spd_votes >= 55) anhalt_adjustment_factors.spd -= 0.3;
if (Q.spd_votes >= 25) anhalt_adjustment_factors.spd -= 0.1;
if (Q.spd_votes >= 35) anhalt_adjustment_factors.spd -= 0.05;
if (Q.chancellor_party == "SPD") anhalt_adjustment_factors.kpd += 0.1;
Q.spd_anhalt_elections_vote = Q.spd_votes*anhalt_adjustment_factors.spd;
Q.sapd_anhalt_elections_vote = Q.sapd_votes*anhalt_adjustment_factors.sapd;
Q.uspd_anhalt_elections_vote = Q.uspd_votes*anhalt_adjustment_factors.uspd;
Q.kpd_anhalt_elections_vote = Q.kpd_votes*anhalt_adjustment_factors.kpd;
if (Q.stolper_program_adopted) anhalt_adjustment_factors.ddp += 0.2;
Q.ddp_anhalt_elections_vote = Q.ddp_votes*anhalt_adjustment_factors.ddp;
Q.lvp_anhalt_elections_vote = Q.lvp_votes*anhalt_adjustment_factors.lvp;
Q.z_anhalt_elections_vote = Q.z_votes*anhalt_adjustment_factors.z;
Q.dvp_anhalt_elections_vote = Q.dvp_votes*anhalt_adjustment_factors.dvp;
if (Q.chancellor_party == "SPD") anhalt_adjustment_factors.dnvp -= 0.2;
Q.dnvp_anhalt_elections_vote = Q.dnvp_votes*anhalt_adjustment_factors.dnvp;          
if (Q.year >= 1930) anhalt_adjustment_factors.nsdap += 0.1;
Q.nsdap_anhalt_elections_vote = Q.nsdap_votes*anhalt_adjustment_factors.nsdap;
if (Q.dvfp_votes <= 2) anhalt_adjustment_factors.spd += 0.2;
Q.dvfp_anhalt_elections_vote = Q.dvfp_votes*anhalt_adjustment_factors.dvfp;
Q.nsfb_anhalt_elections_vote = Q.nsfb_votes*anhalt_adjustment_factors.nsfb;
if (Q.chancellor_party == "SPD") anhalt_adjustment_factors.other -= 0.1;
if (Q.other_votes >= 12) anhalt_adjustment_factors.other -= 0.1;
if (Q.other_votes >= 15) anhalt_adjustment_factors.other -= 0.2;
if (Q.other_votes >= 17) anhalt_adjustment_factors.other -= 0.2;
Q.other_anhalt_elections_vote = Q.other_votes*anhalt_adjustment_factors.other;
Q.kvp_anhalt_elections_vote = Q.kvp_votes*anhalt_adjustment_factors.kvp;
Q.dnf_anhalt_elections_vote = Q.dnf_votes*anhalt_adjustment_factors.dnf;

Q.total_votes_anhalt = Q.spd_anhalt_elections_vote + Q.sapd_anhalt_elections_vote + Q.kpd_anhalt_elections_vote + Q.z_anhalt_elections_vote + Q.ddp_anhalt_elections_vote + Q.lvp_anhalt_elections_vote + Q.dvp_anhalt_elections_vote + Q.dnvp_anhalt_elections_vote + Q.nsdap_anhalt_elections_vote + Q.other_anhalt_elections_vote + Q.kvp_anhalt_elections_vote + Q.dnf_anhalt_elections_vote + Q.uspd_anhalt_elections_vote + Q.dvfp_anhalt_elections_vote + Q.nsfb_anhalt_elections_vote;

if (Q.total_votes_anhalt > 0) {
Q.spd_anhalt_elections_vote = (Q.spd_anhalt_elections_vote / Q.total_votes_anhalt) * 100;
Q.sapd_anhalt_elections_vote = (Q.sapd_anhalt_elections_vote / Q.total_votes_anhalt) * 100;
Q.uspd_anhalt_elections_vote = (Q.uspd_anhalt_elections_vote / Q.total_votes_anhalt) * 100;
Q.kpd_anhalt_elections_vote = (Q.kpd_anhalt_elections_vote / Q.total_votes_anhalt) * 100;
Q.z_anhalt_elections_vote = (Q.z_anhalt_elections_vote / Q.total_votes_anhalt) * 100;
Q.ddp_anhalt_elections_vote = (Q.ddp_anhalt_elections_vote / Q.total_votes_anhalt) * 100;
Q.lvp_anhalt_elections_vote = (Q.lvp_anhalt_elections_vote / Q.total_votes_anhalt) * 100;
Q.dvp_anhalt_elections_vote = (Q.dvp_anhalt_elections_vote / Q.total_votes_anhalt) * 100;
Q.dnvp_anhalt_elections_vote = (Q.dnvp_anhalt_elections_vote / Q.total_votes_anhalt) * 100;
Q.nsdap_anhalt_elections_vote = (Q.nsdap_anhalt_elections_vote / Q.total_votes_anhalt) * 100;
Q.other_anhalt_elections_vote = (Q.other_anhalt_elections_vote / Q.total_votes_anhalt) * 100;
Q.kvp_anhalt_elections_vote = (Q.kvp_anhalt_elections_vote / Q.total_votes_anhalt) * 100;
Q.dnf_anhalt_elections_vote = (Q.dnf_anhalt_elections_vote / Q.total_votes_anhalt) * 100;
Q.dvfp_anhalt_elections_vote = (Q.dvfp_anhalt_elections_vote / Q.total_votes_anhalt) * 100;
Q.nsfb_anhalt_elections_vote = (Q.nsfb_anhalt_elections_vote / Q.total_votes_anhalt) * 100;
}

Q.spd_anhalt_elections_vote = (Q.spd_anhalt_elections_vote != undefined ? parseFloat(Q.spd_anhalt_elections_vote.toFixed(1)) : 0);
Q.sapd_anhalt_elections_vote = (Q.sapd_anhalt_elections_vote != undefined ? parseFloat(Q.sapd_anhalt_elections_vote.toFixed(1)) : 0);
Q.uspd_anhalt_elections_vote = (Q.uspd_anhalt_elections_vote != undefined ? parseFloat(Q.uspd_anhalt_elections_vote.toFixed(1)) : 0);
Q.kpd_anhalt_elections_vote = (Q.kpd_anhalt_elections_vote != undefined ? parseFloat(Q.kpd_anhalt_elections_vote.toFixed(1)) : 0);
Q.z_anhalt_elections_vote = (Q.z_anhalt_elections_vote != undefined ? parseFloat(Q.z_anhalt_elections_vote.toFixed(1)) : 0);   
Q.ddp_anhalt_elections_vote = (Q.ddp_anhalt_elections_vote != undefined ? parseFloat(Q.ddp_anhalt_elections_vote.toFixed(1)) : 0);
Q.lvp_anhalt_elections_vote = (Q.lvp_anhalt_elections_vote != undefined ? parseFloat(Q.lvp_anhalt_elections_vote.toFixed(1)) : 0);
Q.dvp_anhalt_elections_vote = (Q.dvp_anhalt_elections_vote != undefined ? parseFloat(Q.dvp_anhalt_elections_vote.toFixed(1)) : 0);
Q.dnvp_anhalt_elections_vote = (Q.dnvp_anhalt_elections_vote != undefined ? parseFloat(Q.dnvp_anhalt_elections_vote.toFixed(1)) : 0);
Q.nsdap_anhalt_elections_vote = (Q.nsdap_anhalt_elections_vote != undefined ? parseFloat(Q.nsdap_anhalt_elections_vote.toFixed(1)) : 0);
Q.other_anhalt_elections_vote = (Q.other_anhalt_elections_vote != undefined ? parseFloat(Q.other_anhalt_elections_vote.toFixed(1)) : 0);
Q.kvp_anhalt_elections_vote = (Q.kvp_anhalt_elections_vote != undefined ? parseFloat(Q.kvp_anhalt_elections_vote.toFixed(1)) : 0);
Q.dnf_anhalt_elections_vote = (Q.dnf_anhalt_elections_vote != undefined ? parseFloat(Q.dnf_anhalt_elections_vote.toFixed(1)) : 0);
Q.dvfp_anhalt_elections_vote = (Q.dvfp_anhalt_elections_vote != undefined ? parseFloat(Q.dvfp_anhalt_elections_vote.toFixed(1)) : 0);
Q.nsfb_anhalt_elections_vote = (Q.nsfb_anhalt_elections_vote != undefined ? parseFloat(Q.nsfb_anhalt_elections_vote.toFixed(1)) : 0);

if (Q.spd_anhalt_elections_vote >= 1.4) Q.spd_r_anhalt = Q.spd_anhalt_elections_vote;
if (Q.sapd_anhalt_elections_vote >= 1.4) Q.sapd_r_anhalt = Q.sapd_anhalt_elections_vote;
if (Q.uspd_anhalt_elections_vote >= 1.4) Q.uspd_r_anhalt = Q.uspd_anhalt_elections_vote;
if (Q.kpd_anhalt_elections_vote >= 1.4) Q.kpd_r_anhalt = Q.kpd_anhalt_elections_vote;
if (Q.z_anhalt_elections_vote >= 1.4) Q.z_r_anhalt = Q.z_anhalt_elections_vote;
if (Q.ddp_anhalt_elections_vote >= 1.4) Q.ddp_r_anhalt = Q.ddp_anhalt_elections_vote;
if (Q.lvp_anhalt_elections_vote >= 1.4) Q.lvp_r_anhalt = Q.lvp_anhalt_elections_vote;
if (Q.dvp_anhalt_elections_vote >= 1.4) Q.dvp_r_anhalt = Q.dvp_anhalt_elections_vote;
if (Q.dnvp_anhalt_elections_vote >= 1.4) Q.dnvp_r_anhalt = Q.dnvp_anhalt_elections_vote;
if (Q.nsdap_anhalt_elections_vote >= 1.4) Q.nsdap_r_anhalt = Q.nsdap_anhalt_elections_vote;
if (Q.other_anhalt_elections_vote >= 1.4) Q.other_r_anhalt = Q.other_anhalt_elections_vote;
if (Q.kvp_anhalt_elections_vote >= 1.4) Q.kvp_r_anhalt = Q.kvp_anhalt_elections_vote;
if (Q.dnf_anhalt_elections_vote >= 1.4) Q.dnf_r_anhalt = Q.dnf_anhalt_elections_vote;
if (Q.dvfp_anhalt_elections_vote >= 1.4) Q.dvfp_r_anhalt = Q.dvfp_anhalt_elections_vote;
if (Q.nsfb_anhalt_elections_vote >= 1.4) Q.nsfb_r_anhalt = Q.nsfb_anhalt_elections_vote;

var anhalt_adjustment_r_factors = {
spd: 1.0,
sapd: 1.0,
uspd: 1.0,
kpd: 1.0,
ddp: 1.0,
z: 1.0,
lvp: 1.0,
dvp: 1.0,
dnvp: 1.0,
nsdap: 1.0,
other: 1.01,
kvp: 1.0,
dnf: 1.0,
dvfp: 1.0,
nsfb: 1.0
};


Q.spd_r_anhalt = Q.spd_r_anhalt * anhalt_adjustment_r_factors.spd;
Q.sapd_r_anhalt = Q.sapd_r_anhalt * anhalt_adjustment_r_factors.sapd;
Q.uspd_r_anhalt = Q.uspd_r_anhalt * anhalt_adjustment_r_factors.uspd;
Q.kpd_r_anhalt = Q.kpd_r_anhalt * anhalt_adjustment_r_factors.kpd;
Q.ddp_r_anhalt = Q.ddp_r_anhalt * anhalt_adjustment_r_factors.ddp;
Q.lvp_r_anhalt = Q.lvp_r_anhalt * anhalt_adjustment_r_factors.lvp;
Q.z_r_anhalt = Q.z_r_anhalt * anhalt_adjustment_r_factors.z;           
Q.dvp_r_anhalt = Q.dvp_r_anhalt * anhalt_adjustment_r_factors.dvp;
Q.dnvp_r_anhalt = Q.dnvp_r_anhalt * anhalt_adjustment_r_factors.dnvp;
Q.nsdap_r_anhalt = Q.nsdap_r_anhalt * anhalt_adjustment_r_factors.nsdap;
Q.other_r_anhalt = Q.other_r_anhalt * anhalt_adjustment_r_factors.other;
Q.kvp_r_anhalt = Q.kvp_r_anhalt * anhalt_adjustment_r_factors.kvp;
Q.dnf_r_anhalt = Q.dnf_r_anhalt * anhalt_adjustment_r_factors.dnf;
Q.dvfp_r_anhalt = Q.dvfp_r_anhalt * anhalt_adjustment_r_factors.dvfp;
Q.nsfb_r_anhalt = Q.nsfb_r_anhalt * anhalt_adjustment_r_factors.nsfb;

Q.total_r_anhalt = 0;

if (Q.spd_r_anhalt) Q.total_r_anhalt += Q.spd_r_anhalt;
if (Q.sapd_r_anhalt) Q.total_r_anhalt += Q.sapd_r_anhalt;
if (Q.uspd_r_anhalt) Q.total_r_anhalt += Q.uspd_r_anhalt;
if (Q.kpd_r_anhalt) Q.total_r_anhalt += Q.kpd_r_anhalt;
if (Q.z_r_anhalt) Q.total_r_anhalt += Q.z_r_anhalt;
if (Q.ddp_r_anhalt) Q.total_r_anhalt += Q.ddp_r_anhalt;
if (Q.lvp_r_anhalt) Q.total_r_anhalt += Q.lvp_r_anhalt;
if (Q.dvp_r_anhalt) Q.total_r_anhalt += Q.dvp_r_anhalt;
if (Q.dnvp_r_anhalt) Q.total_r_anhalt += Q.dnvp_r_anhalt;
if (Q.nsdap_r_anhalt) Q.total_r_anhalt += Q.nsdap_r_anhalt;
if (Q.other_r_anhalt) Q.total_r_anhalt += Q.other_r_anhalt;
if (Q.kvp_r_anhalt) Q.total_r_anhalt += Q.kvp_r_anhalt;
if (Q.dnf_r_anhalt) Q.total_r_anhalt += Q.dnf_r_anhalt;
if (Q.dvfp_r_anhalt) Q.total_r_anhalt += Q.dvfp_r_anhalt;
if (Q.nsfb_r_anhalt) Q.total_r_anhalt += Q.nsfb_r_anhalt;

if (Q.total_r_anhalt > 0) {
Q.spd_r_anhalt = (Q.spd_r_anhalt / Q.total_r_anhalt) * 100;
Q.sapd_r_anhalt = (Q.sapd_r_anhalt / Q.total_r_anhalt) * 100;
Q.uspd_r_anhalt = (Q.uspd_r_anhalt / Q.total_r_anhalt) * 100;
Q.kpd_r_anhalt = (Q.kpd_r_anhalt / Q.total_r_anhalt) * 100;
Q.z_r_anhalt = (Q.z_r_anhalt / Q.total_r_anhalt) * 100;
Q.ddp_r_anhalt = (Q.ddp_r_anhalt / Q.total_r_anhalt) * 100;
Q.lvp_r_anhalt = (Q.lvp_r_anhalt / Q.total_r_anhalt) * 100;
Q.dvp_r_anhalt = (Q.dvp_r_anhalt / Q.total_r_anhalt) * 100;
Q.dnvp_r_anhalt = (Q.dnvp_r_anhalt / Q.total_r_anhalt) * 100;
Q.nsdap_r_anhalt = (Q.nsdap_r_anhalt / Q.total_r_anhalt) * 100;
Q.other_r_anhalt = (Q.other_r_anhalt / Q.total_r_anhalt) * 100;
Q.kvp_r_anhalt = (Q.kvp_r_anhalt / Q.total_r_anhalt) * 100;
Q.dnf_r_anhalt = (Q.dnf_r_anhalt / Q.total_r_anhalt) * 100;
Q.dvfp_r_anhalt = (Q.dvfp_r_anhalt / Q.total_r_anhalt) * 100;
Q.nsfb_r_anhalt = (Q.nsfb_r_anhalt / Q.total_r_anhalt) * 100;
}

let farm_share = 0.55;
if (Q.dnvp_ideology == "Moderate") farm_share -= 0.03;
let wp_share = 0.3;
if (Q.year >= 1925) wp_share += 0.15;
if (Q.year >= 1929) wp_share -= 0.5;
if (Q.stolper_program_adopted) wp_share -= 0.05;
let true_other_share = 0.4;
if (Q.year >= 1929) true_other_share += 0.2;
if (Q.president == "Hindenburg") true_other_share -= 0.15;
let lr_share = 0.15;
if (Q.year >= 1925) lr_share -= 0.05;

let total_share = wp_share + farm_share + true_other_share + lr_share;

farm_share = (farm_share / total_share);
wp_share = (wp_share / total_share);
lr_share = (lr_share / total_share);
true_other_share = (true_other_share / total_share);

Q.farm_anhalt_elections_vote = Q.other_anhalt_elections_vote*farm_share;
Q.farm_r_anhalt = Q.other_r_anhalt*farm_share;

Q.wp_anhalt_elections_vote = Q.other_anhalt_elections_vote*wp_share;
Q.wp_r_anhalt = Q.other_r_anhalt*wp_share;

Q.lr_anhalt_elections_vote = Q.other_anhalt_elections_vote*lr_share;
Q.lr_r_anhalt = Q.other_r_anhalt*lr_share;

Q.true_other_anhalt_elections_vote = Q.other_anhalt_elections_vote*true_other_share;
Q.true_other_r_anhalt = Q.other_r_anhalt*true_other_share;


function allocateSeats(percentages, totalSeats = 36) {
const exactSeats = {};
const flooredSeats = {};
const remainders = [];

let totalFlooredSeats = 0;
for (const party in percentages) {
const exact = (percentages[party] * totalSeats) / 100;
const floored = Math.floor(exact);
const remainder = exact - floored;

exactSeats[party] = exact;
flooredSeats[party] = floored;
totalFlooredSeats += floored;

remainders.push({ party, remainder });
}

const seatsToDistribute = totalSeats - totalFlooredSeats;
remainders.sort((a, b) => b.remainder - a.remainder);

for (let i = 0; i < seatsToDistribute; i++) {
flooredSeats[remainders[i].party]++;
}

return flooredSeats;
}

const inputPercentages = {
spd_r_anhalt: Q.spd_r_anhalt,
uspd_r_anhalt: Q.uspd_r_anhalt,
sapd_r_anhalt: Q.sapd_r_anhalt,
kpd_r_anhalt: Q.kpd_r_anhalt,
z_r_anhalt: Q.z_r_anhalt,
ddp_r_anhalt: Q.ddp_r_anhalt,
lvp_r_anhalt: Q.lvp_r_anhalt,
dvp_r_anhalt: Q.dvp_r_anhalt,
dnvp_r_anhalt: Q.dnvp_r_anhalt,
nsdap_r_anhalt: Q.nsdap_r_anhalt,
wp_r_anhalt: Q.wp_r_anhalt,
lr_r_anhalt: Q.lr_r_anhalt,
farm_r_anhalt: Q.farm_r_anhalt,
true_other_r_anhalt: Q.true_other_r_anhalt,
kvp_r_anhalt: Q.kvp_r_anhalt,
dnf_r_anhalt: Q.dnf_r_anhalt,
dvfp_r_anhalt: Q.dvfp_r_anhalt,
nsfb_r_anhalt: Q.nsfb_r_anhalt
};

const allocatedSeats = allocateSeats(inputPercentages);

for (const party in allocatedSeats) {
Q[party] = parseFloat(((allocatedSeats[party] * 100) / 36).toFixed(1));
}

Q.other_r_anhalt = Q.wp_r_anhalt + Q.true_other_r_anhalt + Q.lr_r_anhalt + Q.farm_r_anhalt;

if (Q.anhalt_new_election_called == 1) Q.vg_r_anhalt = Q.dnvp_r_anhalt + Q.dvp_r_anhalt + Q.true_other_r_anhalt + Q.wp_r_anhalt + Q.farm_r_anhalt;

Q.left_coalition_anhalt = parseFloat((Q.spd_r_anhalt + Q.kpd_r_anhalt + Q.sapd_r_anhalt + Q.uspd_r_anhalt).toFixed(1));
Q.bourgeois_coalition_anhalt = parseFloat((Q.ddp_r_anhalt + Q.dvp_r_anhalt + Q.lvp_r_anhalt + Q.kvp_r_anhalt + Q.other_r_anhalt).toFixed(1));
Q.right_coalition_anhalt = parseFloat((Q.dnvp_r_anhalt + Q.dvp_r_anhalt + Q.dvfp_r_anhalt + Q.nsdap_r_anhalt + Q.wp_r_anhalt + Q.farm_r_anhalt).toFixed(1));
Q.thick_bourgeois_coalition_anhalt = parseFloat((Q.ddp_r_anhalt + Q.dvp_r_anhalt + Q.lvp_r_anhalt + Q.kvp_r_anhalt + Q.other_r_anhalt + Q.dnvp_r_anhalt).toFixed(1));
Q.social_liberal_coalition_anhalt = parseFloat((Q.spd_r_anhalt + Q.ddp_r_anhalt + Q.lvp_r_anhalt + Q.lr_r_anhalt).toFixed(1));

Q.wp_anhalt_elections_vote = (Q.wp_anhalt_elections_vote != undefined ? parseFloat(Q.wp_anhalt_elections_vote.toFixed(1)) : 0);
Q.true_other_anhalt_elections_vote = (Q.true_other_anhalt_elections_vote != undefined ? parseFloat(Q.true_other_anhalt_elections_vote.toFixed(1)) : 0);
Q.lr_anhalt_elections_vote = (Q.lr_anhalt_elections_vote != undefined ? parseFloat(Q.lr_anhalt_elections_vote.toFixed(1)) : 0);
Q.farm_anhalt_elections_vote = (Q.farm_anhalt_elections_vote != undefined ? parseFloat(Q.farm_anhalt_elections_vote.toFixed(1)) : 0);
Q.wp_r_anhalt = (Q.wp_r_anhalt != undefined ? parseFloat(Q.wp_r_anhalt.toFixed(1)) : 0);
Q.true_other_r_anhalt = (Q.true_other_r_anhalt != undefined ? parseFloat(Q.true_other_r_anhalt.toFixed(1)) : 0);
Q.lr_r_anhalt = (Q.lr_r_anhalt != undefined ? parseFloat(Q.lr_r_anhalt.toFixed(1)) : 0);
Q.farm_r_anhalt = (Q.farm_r_anhalt != undefined ? parseFloat(Q.farm_r_anhalt.toFixed(1)) : 0);             


if (Q.anhalt_new_election_called == 1) { Q.dnvp_r_anhalt; Q.dvp_r_anhalt; Q.true_other_r_anhalt; Q.wp_r_anhalt; Q.farm_r_anhalt; }

!}
on-display: {!
data = [{
"id": "kpd",
"legend": "KPD",
"name": "KPD",
"seats": Math.round(Q.kpd_r_anhalt * 0.36),
}];

if (Q.sapd_formed && Q.sapd_r_anhalt) {
data.push({
"id": "sapd",
"legend": "SAPD",
"name": "SAPD",
"seats": Math.round(Q.sapd_r_anhalt * 0.36),
});
}

if (Q.uspd_r_anhalt) {
data.push({
"id": "uspd",
"legend": "USPD",
"name": "USPD",
"seats": Math.round(Q.uspd_r_anhalt * 0.36),
});
}

data = data.concat([{
"id": "spd",
"legend": "SPD",
"name": "SPD",
"seats": Math.round(Q.spd_r_anhalt * 0.36),
}]);

if (Q.ddp_r_anhalt && !Q.lvp_formed) {
data.push({
"id": "ddp",
"legend": Q.ddp_name,
"name": Q.ddp_name,
"seats": Math.round(Q.ddp_r_anhalt * 0.36),
});
}

if (Q.lvp_r_anhalt && Q.lvp_formed) {
data.push({
"id": "lvp",
"legend": "LVP",
"name": "LVP",
"seats": Math.round(Q.lvp_r_anhalt * 0.36),
});
}

if (Q.z_r_anhalt) {
data.push({
"id": "z",
"legend": "Z",
"name": "Z",
"seats": Math.round(Q.z_r_anhalt * 0.36),
});
}

if (Q.lr_r_anhalt) {
data.push({
"id": "kag",
"legend": "Land Reform",
"name": "Land Reform",
"seats": Math.round(Q.lr_r_anhalt * 0.36),
});
}

if (Q.dvp_r_anhalt && !Q.lvp_formed && Q.dvp_exist) {
data.push({
"id": "dvp",
"legend": "DVP",
"name": "DVP",
"seats": Math.round(Q.dvp_r_anhalt * 0.36),
});
}

if (Q.true_other_r_anhalt) {
data.push({
"id": "other",
"legend": "Other",
"name": "Others",
"seats": Math.round(Q.true_other_r_anhalt * 0.36),
});
}
             
if (Q.kvp_formed && Q.kvp_r_anhalt) {
data.push({
"id": "kvp",
"legend": "KVP",
"name": "KVP",
"seats": Math.round(Q.kvp_r_anhalt * 0.36),
});
}            

if (Q.vg_r_anhalt) {
data.push({
"id": "rl",
"legend": "Volksgemeinschaft",
"name": "Volksgemeinschaft",
"seats": Math.round(Q.vg_r_anhalt * 0.36),
});
}

if (Q.wp_r_anhalt) {
data.push({
"id": "wp",
"legend": "WP",
"name": "WP",
"seats": Math.round(Q.wp_r_anhalt * 0.36),
});
}

if (Q.farm_r_anhalt) {
data.push({
"id": "farm2",
"legend": "Farm",
"name": "Farm",
"seats": Math.round(Q.farm_r_anhalt * 0.36),
});
}
             
data = data.concat([{
"id": "dnvp",
"legend": "DNVP",
"name": "DNVP",
"seats": Math.round(Q.dnvp_r_anhalt * 0.36),
}]);

if (Q.dnf_formed && Q.dnf_r_anhalt) {
data.push({
"id": "dnf",
"legend": "DNF",
"name": "DNF",
"seats": Math.round(Q.dnf_r_anhalt * 0.36),
});
}

data.push({
"id": "dvfp",
"legend": "DVFP",
"name": "DVFP",
"seats": Math.round(Q.dvfp_r_anhalt * 0.36),
"color": "#3D3D3D"
});

data.push({
"id": "dvfp",
"legend": "NSFB",
"name": "NSFB",
"seats": Math.round(Q.nsfb_r_anhalt * 0.36),
});

data = data.concat([{
"id": "nsdap",
"legend": "NSDAP",
"name": "NSDAP",
"seats": Math.round(Q.nsdap_r_anhalt * 0.36),
}]);

if (window && d3) {
var width = 500;
var height = 500;
var screenWidth = document.getElementById('content').offsetWidth;
if (screenWidth < width - 50) {
width = screenWidth - 50;
height = width;
document.getElementById("anhalt_landtag").style.height = screenWidth/2 + "px";
}
var parliament = d3.parliament();
parliament.width(width).height(height).innerRadiusCoef(0.4);
parliament.enter.fromCenter(true).smallToBig(true);
parliament.exit.toCenter(false).bigToSmall(true);
d3.select("#anhalt_landtag").datum(data).call(parliament);
}
!}
