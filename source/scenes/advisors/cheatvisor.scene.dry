title: The Cheatvisor
is-pinned-card: true 
tags: advisor, centrist
card-image: img/portraits/schleicher_pro.jpg
new-page: true
view-if: cheatvisor_hidden == 0

= The Cheatvisor


The Cheatvisor is just a tool to make testing the mod easier, nothing special

- @bufff
- @make_nsfb
- @kill_nsfb
- @stuulll
- @eber_party
- @new_prussia_leader
- @new_chancellor
- @new_president
- @scene_testing_shortcuts
- @assemble_reichsrat
- @party_assembly
- @give_absurd_other
- @media_shit
- @hide
- @root: Return to main


@bufff
title: Little Cheat
subtitle: It has gotten so hard to test this stuff
on-arrival: rural_spd += 10; catholics_spd += 9; new_middle_spd += 2

@scene_testing_shortcuts
title: Scene Testing shortcuts

- @1924_party_conference: 1924 Conference
- @presidential_election_candidate: Presidential election

@1924_party_conference
go-to: conference_1924

@presidential_election_1925_candidate
go-to: presidential_election_1925_candidate

@make_nsfb
title: Make NSFB
view-if: nsfb_exists == 0
on-arrival: nsfb_exists = 1; workers_nsfb = workers_nsdap + workers_dvfp; unemployed_nsfb = unemployed_nsdap + unemployed_dvfp; new_middle_nsfb = new_middle_nsdap + new_middle_dvfp; old_middle_nsfb = old_middle_nsdap + old_middle_dvfp; rural_nsfb = rural_nsdap + rural_dvfp; catholic_nsfb = catholic_nsdap + catholic_dvfp; nsfb_r = nsdap_r + dvfp_r; nsdap_r = 0; dvfp_r = 0; workers_nsdap = 0; workers_dvfp = 0; new_middle_nsdap = 0; new_middle_dvfp = 0; old_middle_nsdap = 0; old_middle_dvfp = 0; rural_nsdap = 0; rural_dvfp = 0; unemployed_nsdap = 0; unemployed_dvfp = 0; catholic_nsdap = 0; catholic_dvfp = 0

@kill_nsfb
title: Kill NSFB
view-if: nsfb_exists == 1
on-arrival: nsfb_exists = 0; workers_nsdap = workers_nsfb; unemployed_nsdap = unemployed_nsfb; new_middle_nsdap = new_middle_nsfb; old_middle_nsdap = old_middle_nsfb; rural_nsdap = rural_nsfb; catholic_nsdap = catholic_nsfb; dvfp_r = nsfb_r; nsfb_r = 0; workers_nsfb = 0; new_middle_nsfb = 0; old_middle_nsfb = 0; rural_nsfb = 0; unemployed_nsfb = 0; catholic_nsfb = 0

@eber_party
title: Choose Ebert Party

- @spd: SPD
- @ddp: DDP
- @i: I
- @aspd: ASPD

@spd
on-arrival: ebert_in = "SPD"

@ddp
on-arrival: ebert_in = "DDP"

@i
on-arrival: ebert_in = "I"

@aspd
on-arrival: ebert_in = "ASPD"

@stuulll
title: Shuffle time
on-arrival: shuffle_leadership_timer = 0

@new_prussia_leader
title: Choose Prussia Leader

- @stegerwald: Stegerwald
- @rosenfeld: Rosenfeld
- @goering: Göring

@stegerwald
on-arrival: prussia_leader = "Stegerwald"; prussia_leader_party = z_party_name

@rosenfeld
on-arrival: prussia_leader = "Rosenfeld"; prussia_leader_party = rosenfeld_in

@goering
on-arrival: prussia_leader = "Göring"; prussia_leader_party = "NSDAP"

@new_chancellor
title: Choose Chancellor

- @breitscheid: Breitscheid
- @liebknecht: Liebknecht
- @stresemann: Stresemann

@breitscheid
on-arrival: chancellor = "Breitscheid"; chancellor_party = breitscheid_in

@liebknecht
on-arrival: chancellor = "Liebknecht"; chancellor_party = liebknecht_in

@stresemann
on-arrival: chancellor = "Stresemann"; chancellor_party = "DVP" if not lvp_formed; chancellor_party = "LVP" if lvp_formed


@new_president
title: Choose President

- @hindenburg: Hindenburg
- @ebert: Ebert
- @ledebour: Ledebour
- @jarres: Jarres

@hindenburg
on-arrival: president = "Hindenburg"; president_party = "I"

@ebert
on-arrival: president = "Ebert"

@ledebour
on-arrival: president = "Ledebour"

@jarres
on-arrival: president = "Jarres"; president_party = "DVP"

@hide
title: Remove the Cheatvisor
on-arrival: cheatvisor_hidden = 1



@assemble_reichsrat
title: Reichsrat (Test)
on-arrival: {!

// Initialize Reichsrat seat counts
Q.kpd_r_reichsrat = 0;
Q.left_r_reichsrat = 0;
Q.socdem_r_reichsrat = 0;
Q.spd_r_reichsrat = 0;
Q.popular_front_r_reichsrat = 0;
Q.weimar_r_reichsrat = 0;
Q.soc_lib_r_reichsrat = 0;
Q.soc_christ_r_reichsrat = 0;
Q.grand_r_reichsrat = 0;
Q.bourgeois_r_reichsrat = 0;
Q.bourgeois_right_r_reichsrat = 0;
Q.nsdap_r_reichsrat = 0;
Q.bvp_r_reichsrat = 0;
Q.anti_bvp_r_reichsrat = 0;

// Prussia (26 seats) - 13 from the central government, 13 from local ones (but a few had roughly always the same arrangement)
if (Q.in_left_coalition_prussia) Q.left_r_reichsrat = (Q.left_r_reichsrat + 16);
if (Q.in_socdem_coalition_prussia) Q.socdem_r_reichsrat = (Q.socdem_r_reichsrat + 16);
if (Q.prussia_gov == "SPD") Q.spd_r_reichsrat = (Q.spd_r_reichsrat + 16);
if (Q.prussia_gov == "Weimar") Q.weimar_r_reichsrat = (Q.weimar_r_reichsrat + 16);
if (Q.prussia_gov == "Grand") Q.grand_r_reichsrat = (Q.grand_r_reichsrat + 16);
if (Q.prussia_gov == "Popular-Front") Q.popular_front_r_reichsrat = (Q.popular_front_r_reichsrat + 16);
if (Q.prussia_gov == "Social-Catholic") Q.soc_christ_r_reichsrat = (Q.soc_christ_r_reichsrat + 16);
if (Q.prussia_gov == "Right") Q.bourgeois_right_r_reichsrat = (Q.bourgeois_right_r_reichsrat + 16);
if (Q.prussia_gov == "Bourgeois") Q.bourgeois_r_reichsrat = (Q.bourgeois_r_reichsrat + 16);

// Berlin
if (Q.kpd_relation >= 55) Q.left_r_reichsrat = (Q.left_r_reichsrat + 1);
if (Q.kpd_relation < 55)  Q.grand_r_reichsrat = (Q.grand_r_reichsrat + 1);

// East Prussia
if (Q.dnvp_votes >= 16) Q.bourgeois_right_r_reichsrat = (Q.bourgeois_right_r_reichsrat + 1);
if (Q.dnvp_votes < 16 && Q.dnvp_votes >= 7)  Q.bourgeois_r_reichsrat = (Q.bourgeois_r_reichsrat + 1);
if (Q.dnvp_votes < 7 && Q.spd_votes >= 60) Q.spd_r_reichsrat = (Q.spd_r_reichsrat + 1);

// Deaply Catholic Provinces
if (Q.prussia_gov == "Social-Catholic") Q.soc_christ_r_reichsrat = (Q.soc_christ_r_reichsrat + 3);
if (!Q.prussia_gov == "Social-Catholic" && Q.z_relation < 55) Q.bourgeois_r_reichsrat = (Q.bourgeois_r_reichsrat + 3);
if (!Q.prussia_gov == "Social-Catholic" && Q.z_relation >= 55) Q.soc_christ_r_reichsrat = (Q.soc_christ_r_reichsrat + 3);

// Prussian Saxony
if (Q.spd_votes >= 40) Q.spd_r_reichsrat = (Q.spd_r_reichsrat + 1);
if (Q.spd_votes < 40 && Q.spd_votes >= 35 && Q.kpd_relation >= 55) Q.left_r_reichsrat = (Q.left_r_reichsrat + 1);
if (Q.spd_votes < 40 && Q.dvp_relation >= 40) Q.grand_r_reichsrat = (Q.grand_r_reichsrat + 1);
if (Q.spd_votes < 40 && Q.dvp_relation < 40 && Q.kpd_relation < 55) Q.bourgeois_r_reichsrat = (Q.bourgeois_r_reichsrat + 1);

// others
if (Q.nsdap_votes < 15) Q.weimar_r_reichsrat = (Q.weimar_r_reichsrat + 4);
if (Q.nsdap_votes >= 15 && Q.nsdap_votes < 30) Q.bourgeois_right_r_reichsrat = (Q.bourgeois_right_r_reichsrat + 4);
if (Q.nsdap_votes >= 30) Q.nsdap_r_reichsrat = (Q.nsdap_r_reichsrat + 4);


// Bavaria (11 seats)
if (Q.bavaria_gov == "Right") Q.bourgeois_right_r_reichsrat = (Q.bourgeois_right_r_reichsrat + 11);
if (Q.bavaria_gov == "Bourgeois") Q.bourgeois_r_reichsrat = (Q.bourgeois_r_reichsrat + 11);
if (Q.bavaria_gov == "BVP") Q.bvp_r_reichsrat = (Q.bvp_r_reichsrat + 11);
if (Q.bavaria_gov == "Anti-BVP") Q.anti_bvp_r_reichsrat = (Q.anti_bvp_r_reichsrat + 11);
if (Q.bavaria_gov == "SPD") Q.spd_r_reichsrat = (Q.spd_r_reichsrat + 11);
if (Q.bavaria_gov == "Left") Q.left_r_reichsrat = (Q.left_r_reichsrat + 11);

// Saxony (7 seats)
if (Q.saxony_gov == "Left") Q.left_r_reichsrat = (Q.left_r_reichsrat + 7);
if (Q.saxony_gov == "Social-Democratic") Q.socdem_r_reichsrat = (Q.socdem_r_reichsrat + 7);
if (Q.saxony_gov == "SPD") Q.spd_r_reichsrat = (Q.spd_r_reichsrat + 7);
if (Q.saxony_gov == "Weimar") Q.weimar_r_reichsrat = (Q.weimar_r_reichsrat + 7);
if (Q.saxony_gov == "Social-Liberal") Q.soc_lib_r_reichsrat = (Q.soc_lib_r_reichsrat + 7);
if (Q.saxony_gov == "Grand") Q.grand_r_reichsrat = (Q.grand_r_reichsrat + 7);
if (Q.saxony_gov == "Bourgeois") Q.bourgeois_r_reichsrat = (Q.bourgeois_r_reichsrat + 7);
if (Q.saxony_gov == "Right") Q.bourgeois_right_r_reichsrat = (Q.bourgeois_right_r_reichsrat + 7);

// Württemberg (4 seats)
if (Q.wurttemberg_gov == "Left") Q.left_r_reichsrat = (Q.left_r_reichsrat + 4);
if (Q.wurttemberg_gov == "Social-Democratic") Q.socdem_r_reichsrat = (Q.socdem_r_reichsrat + 4);
if (Q.wurttemberg_gov == "SPD") Q.spd_r_reichsrat = (Q.spd_r_reichsrat + 4);
if (Q.wurttemberg_gov == "Weimar") Q.weimar_r_reichsrat = (Q.weimar_r_reichsrat + 4);
if (Q.wurttemberg_gov == "Social-Catholic") Q.soc_christ_r_reichsrat = (Q.soc_christ_r_reichsrat + 4);
if (Q.wurttemberg_gov == "Bourgeois") Q.bourgeois_r_reichsrat = (Q.bourgeois_r_reichsrat + 4);
if (Q.wurttemberg_gov == "Right") Q.bourgeois_right_r_reichsrat = (Q.bourgeois_right_r_reichsrat + 4);

// Baden (3 seats)
if (Q.baden_gov == "Left") Q.left_r_reichsrat = (Q.left_r_reichsrat + 3);
if (Q.baden_gov == "Social-Democratic") Q.socdem_r_reichsrat = (Q.socdem_r_reichsrat + 3);
if (Q.baden_gov == "SPD") Q.spd_r_reichsrat = (Q.spd_r_reichsrat + 3);
if (Q.baden_gov == "Weimar") Q.weimar_r_reichsrat = (Q.weimar_r_reichsrat + 3);
if (Q.baden_gov == "Social-Catholic") Q.soc_christ_r_reichsrat = (Q.soc_christ_r_reichsrat + 3);
if (Q.baden_gov == "Bourgeois") Q.bourgeois_r_reichsrat = (Q.bourgeois_r_reichsrat + 3);
if (Q.baden_gov == "Right") Q.bourgeois_right_r_reichsrat = (Q.bourgeois_right_r_reichsrat + 3);

// Thuringia (2 seats)
if (Q.thuringia_gov == "Left") Q.left_r_reichsrat = (Q.left_r_reichsrat + 2);
if (Q.thuringia_gov == "Social-Democratic") Q.socdem_r_reichsrat = (Q.socdem_r_reichsrat + 2);
if (Q.thuringia_gov == "SPD") Q.spd_r_reichsrat = (Q.spd_r_reichsrat + 2);
if (Q.thuringia_gov == "Weimar") Q.weimar_r_reichsrat = (Q.weimar_r_reichsrat + 2);
if (Q.thuringia_gov == "Social-Liberal") Q.soc_lib_r_reichsrat = (Q.soc_lib_r_reichsrat + 2);
if (Q.thuringia_gov == "Bourgeois") Q.bourgeois_r_reichsrat = (Q.bourgeois_r_reichsrat + 2);
if (Q.thuringia_gov == "Right") Q.bourgeois_right_r_reichsrat = (Q.bourgeois_right_r_reichsrat + 2);

// Hesse (2 seats)
if (Q.hesse_gov == "Left") Q.left_r_reichsrat = (Q.left_r_reichsrat + 2);
if (Q.hesse_gov == "Social-Democratic") Q.socdem_r_reichsrat = (Q.socdem_r_reichsrat + 2);
if (Q.hesse_gov == "SPD") Q.spd_r_reichsrat = (Q.spd_r_reichsrat + 2);
if (Q.hesse_gov == "Weimar") Q.weimar_r_reichsrat = (Q.weimar_r_reichsrat + 2);
if (Q.hesse_gov == "Social-Catholic") Q.soc_christ_r_reichsrat = (Q.soc_christ_r_reichsrat + 2);
if (Q.hesse_gov == "Bourgeois") Q.bourgeois_r_reichsrat = (Q.bourgeois_r_reichsrat + 2);
if (Q.hesse_gov == "Right") Q.bourgeois_right_r_reichsrat = (Q.bourgeois_right_r_reichsrat + 2);

// Hamburg (2 seats)
if (Q.hamburg_gov == "KPD") Q.kpd_r_reichsrat = (Q.kpd_r_reichsrat + 2);
if (Q.hamburg_gov == "Social-Democratic") Q.socdem_r_reichsrat = (Q.socdem_r_reichsrat + 2);
if (Q.hamburg_gov == "SPD") Q.spd_r_reichsrat = (Q.spd_r_reichsrat + 2);
if (Q.hamburg_gov == "Weimar") Q.weimar_r_reichsrat = (Q.weimar_r_reichsrat + 2);
if (Q.hamburg_gov == "Grand") Q.grand_r_reichsrat = (Q.grand_r_reichsrat + 2);
if (Q.hamburg_gov == "Bourgeois") Q.bourgeois_r_reichsrat = (Q.bourgeois_r_reichsrat + 2);

// Bremen (1 seat)
if (Q.bremen_gov == "Left") Q.left_r_reichsrat = (Q.left_r_reichsrat + 1);
if (Q.bremen_gov == "Social-Democratic") Q.socdem_r_reichsrat = (Q.socdem_r_reichsrat + 1);
if (Q.bremen_gov == "SPD") Q.spd_r_reichsrat = (Q.spd_r_reichsrat + 1);
if (Q.bremen_gov == "Weimar") Q.weimar_r_reichsrat = (Q.weimar_r_reichsrat + 1);
if (Q.bremen_gov == "Bourgeois") Q.bourgeois_r_reichsrat = (Q.bourgeois_r_reichsrat + 1);

// Anhalt
if (Q.anhalt_gov == "SPD") Q.spd_r_reichsrat = (Q.spd_r_reichsrat + 1);
if (Q.anhalt_gov == "Social-Liberal") Q.soc_lib_r_reichsrat = (Q.soc_lib_r_reichsrat + 1);
if (Q.anhalt_gov == "Weimar") Q.weimar_r_reichsrat = (Q.weimar_r_reichsrat + 1);
if (Q.anhalt_gov == "Bourgeois") Q.bourgeois_r_reichsrat = (Q.bourgeois_r_reichsrat + 1);

// Brunswick
if (Q.brunswick_gov == "SPD") Q.spd_r_reichsrat = (Q.spd_r_reichsrat + 1);
if (Q.brunswick_gov == "Social-Liberal") Q.soc_lib_r_reichsrat = (Q.soc_lib_r_reichsrat + 1);
if (Q.brunswick_gov == "Weimar") Q.weimar_r_reichsrat = (Q.weimar_r_reichsrat + 1);
if (Q.brunswick_gov == "Bourgeois") Q.bourgeois_r_reichsrat = (Q.bourgeois_r_reichsrat + 1);

// Lippe
if (Q.lippe_gov == "SPD") Q.spd_r_reichsrat = (Q.spd_r_reichsrat + 1);
if (Q.lippe_gov == "Social-Liberal") Q.soc_lib_r_reichsrat = (Q.soc_lib_r_reichsrat + 1);
if (Q.lippe_gov == "Weimar") Q.weimar_r_reichsrat = (Q.weimar_r_reichsrat + 1);
if (Q.lippe_gov == "Bourgeois") Q.bourgeois_r_reichsrat = (Q.bourgeois_r_reichsrat + 1);

// Lübeck
if (Q.luebekc_gov == "SPD") Q.spd_r_reichsrat = (Q.spd_r_reichsrat + 1);
if (Q.luebekc_gov == "Social-Liberal") Q.soc_lib_r_reichsrat = (Q.soc_lib_r_reichsrat + 1);
if (Q.luebekc_gov == "Weimar") Q.weimar_r_reichsrat = (Q.weimar_r_reichsrat + 1);
if (Q.luebekc_gov == "Bourgeois") Q.bourgeois_r_reichsrat = (Q.bourgeois_r_reichsrat + 1);

// Mecklenburg-Schwerin
if (Q.meck_schwe_gov == "SPD") Q.spd_r_reichsrat = (Q.spd_r_reichsrat + 1);
if (Q.meck_schwe_gov == "Social-Liberal") Q.soc_lib_r_reichsrat = (Q.soc_lib_r_reichsrat + 1);
if (Q.meck_schwe_gov == "Weimar") Q.weimar_r_reichsrat = (Q.weimar_r_reichsrat + 1);
if (Q.meck_schwe_gov == "Bourgeois") Q.bourgeois_r_reichsrat = (Q.bourgeois_r_reichsrat + 1);

// Mecklenburg-Strelitz
if (Q.meck_stre_gov == "SPD") Q.spd_r_reichsrat = (Q.spd_r_reichsrat + 1);
if (Q.meck_stre_gov == "Social-Liberal") Q.soc_lib_r_reichsrat = (Q.soc_lib_r_reichsrat + 1);
if (Q.meck_stre_gov == "Weimar") Q.weimar_r_reichsrat = (Q.weimar_r_reichsrat + 1);
if (Q.meck_stre_gov == "Bourgeois") Q.bourgeois_r_reichsrat = (Q.bourgeois_r_reichsrat + 1);

// Oldenburg
if (Q.oldenburg_gov == "SPD") Q.spd_r_reichsrat = (Q.spd_r_reichsrat + 1);
if (Q.oldenburg_gov == "Social-Liberal") Q.soc_lib_r_reichsrat = (Q.soc_lib_r_reichsrat + 1);
if (Q.oldenburg_gov == "Weimar") Q.weimar_r_reichsrat = (Q.weimar_r_reichsrat + 1);
if (Q.oldenburg_gov == "Bourgeois") Q.bourgeois_r_reichsrat = (Q.bourgeois_r_reichsrat + 1);

// Schaumburg-Lippe
if (Q.schaum_lippe_gov == "SPD") Q.spd_r_reichsrat = (Q.spd_r_reichsrat + 1);
if (Q.schaum_lippe_gov == "Social-Liberal") Q.soc_lib_r_reichsrat = (Q.soc_lib_r_reichsrat + 1);
if (Q.schaum_lippe_gov == "Weimar") Q.weimar_r_reichsrat = (Q.weimar_r_reichsrat + 1);
if (Q.schaum_lippe_gov == "Bourgeois") Q.bourgeois_r_reichsrat = (Q.bourgeois_r_reichsrat + 1);

// Waldeck
if (Q.waldeck_gov == "SPD") Q.spd_r_reichsrat = (Q.spd_r_reichsrat + 1);
if (Q.waldeck_gov == "Social-Liberal") Q.soc_lib_r_reichsrat = (Q.soc_lib_r_reichsrat + 1);
if (Q.waldeck_gov == "Popular-Front") Q.popular_front_r_reichsrat = (Q.popular_front_r_reichsrat + 1);
if (Q.waldeck_gov == "Bourgeois") Q.bourgeois_r_reichsrat = (Q.bourgeois_r_reichsrat + 1);
if (Q.waldeck_gov == "Right") Q.bourgeois_right_r_reichsrat = (Q.bourgeois_right_r_reichsrat + 1);




// Calculate total Reichsrat seats
Q.total_reichsrat_seats = Q.kpd_r_reichsrat + Q.left_r_reichsrat + Q.socdem_r_reichsrat + 
                          Q.spd_r_reichsrat + Q.popular_front_r_reichsrat + Q.weimar_r_reichsrat + 
                          Q.soc_lib_r_reichsrat + Q.soc_christ_r_reichsrat + Q.grand_r_reichsrat + 
                          Q.bourgeois_r_reichsrat + Q.bourgeois_right_r_reichsrat + Q.nsdap_r_reichsrat + 
                          Q.bvp_r_reichsrat + Q.anti_bvp_r_reichsrat;

// Coalition totals (for reference)
Q.left_coalition_reichsrat = Q.left_r_reichsrat + Q.kpd_r_reichsrat;
Q.socdem_coalition_reichsrat = Q.socdem_r_reichsrat + Q.spd_r_reichsrat;
Q.weimar_coalition_reichsrat = Q.weimar_r_reichsrat;
Q.grand_coalition_reichsrat = Q.grand_r_reichsrat;
Q.popular_front_coalition_reichsrat = Q.popular_front_r_reichsrat;
Q.bourgeois_coalition_reichsrat = Q.bourgeois_r_reichsrat + Q.bvp_r_reichsrat;
Q.right_coalition_reichsrat = Q.bourgeois_right_r_reichsrat + Q.nsdap_r_reichsrat;

!}
on-display: {!
// Prepare data for visualization
data = [];

if (Q.kpd_r_reichsrat > 0) {
    data.push({
        "id": "kpd",
        "legend": "KPD",
        "name": "KPD",
        "seats": Q.kpd_r_reichsrat,
    });
}

if (Q.left_r_reichsrat > 0) {
    data.push({
        "id": "pcf",
        "legend": "Left",
        "name": "Left",
        "seats": Q.left_r_reichsrat,
    });
}

if (Q.socdem_r_reichsrat > 0) {
    data.push({
        "id": "socdem",
        "legend": "Socdem",
        "name": "Socdem",
        "seats": Q.socdem_r_reichsrat,
    });
}

if (Q.spd_r_reichsrat > 0) {
    data.push({
        "id": "spd",
        "legend": "SPD",
        "name": "SPD",
        "seats": Q.spd_r_reichsrat,
    });
}

if (Q.popular_front_r_reichsrat > 0) {
    data.push({
        "id": "popfront",
        "legend": "Popular Front",
        "name": "Popular Front",
        "seats": Q.popular_front_r_reichsrat,
    });
}

if (Q.weimar_r_reichsrat > 0) {
    data.push({
        "id": "weimar",
        "legend": "Weimar Coalition",
        "name": "Weimar Coalition",
        "seats": Q.weimar_r_reichsrat,
    });
}

if (Q.soc_lib_r_reichsrat > 0) {
    data.push({
        "id": "soclib",
        "legend": "Social-Liberal",
        "name": "Social-Liberal",
        "seats": Q.soc_lib_r_reichsrat,
    });
}

if (Q.soc_christ_r_reichsrat > 0) {
    data.push({
        "id": "socsath",
        "legend": "Social-Christian",
        "name": "Social-Christian",
        "seats": Q.soc_christ_r_reichsrat,
    });
}

if (Q.anti_bvp_r_reichsrat > 0) {
    data.push({
        "id": "notbvp",
        "legend": "Anti-BVP",
        "name": "Anti-BVP",
        "seats": Q.anti_bvp_r_reichsrat,
    });
}

if (Q.grand_r_reichsrat > 0) {
    data.push({
        "id": "grand",
        "legend": "Grand Coalition",
        "name": "Grand Coalition",
        "seats": Q.grand_r_reichsrat,
    });
}

if (Q.bourgeois_r_reichsrat > 0) {
    data.push({
        "id": "other",
        "legend": "Bourgeois",
        "name": "Bourgeois",
        "seats": Q.bourgeois_r_reichsrat,
    });
}

if (Q.bvp_r_reichsrat > 0) {
    data.push({
        "id": "bvp",
        "legend": "BVP",
        "name": "BVP",
        "seats": Q.bvp_r_reichsrat,
    });
}

if (Q.bourgeois_right_r_reichsrat > 0) {
    data.push({
        "id": "bourgeois_right",
        "legend": "Right",
        "name": "Right",
        "seats": Q.bourgeois_right_r_reichsrat,
    });
}

if (Q.nsdap_r_reichsrat > 0) {
    data.push({
        "id": "nsdap",
        "legend": "NSDAP",
        "name": "NSDAP",
        "seats": Q.nsdap_r_reichsrat,
    });
}

// Visualization setup
if (window && d3) {
    var width = 500;
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50;
        height = width;
        document.getElementById("reichsrat_viz").style.height = screenWidth/2 + "px";
    }
    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#reichsrat_viz").datum(data).call(parliament);
}
!}

{!<svg id="reichsrat_viz" style="width: 500px; height: 250px;"> </svg>!}


