= French Senatorials 1924

The Third French Republic has a system with two chambers that elect the president.


- @result_button: Let's see what it will show...

@result_button
go-to: left_sweep if ruhr_occupied == 1 else left_victory









@left_sweep
on-arrival: {!
Q.senat_socs = 14;
Q.senat_rads = 152;
Q.senat_reps = 101;
Q.senat_droit = 34;
Q.senat_cons = 14;


             
  setTimeout(function() {
    var el = document.getElementById('france_senat');
    if (!el || typeof d3 === 'undefined' || !window.ParliamentData) return;
    el.removeAttribute('data-parliament');
    el.innerHTML = '';
    window.ParliamentData.renderParliament('france_senat', el);
  }, 0);
!}
  
<div id="france_senat" style="width:500px; height:250px;"></div>




