    </circle> ?]
    <circle
[? if sapd_formed:    style="fill:#ac0000;fill-opacity:1;stroke:#000000;stroke-width:1.947;stroke-linejoin:miter;stroke-miterlimit:4;stroke-dasharray:none;stroke-opacity:1;paint-order:normal"
